+
+struct air_mdio;
+
+#define EN8811_FW_DM	"airoha/EthMD32.dm.bin"
+#define EN8811_FW_DSP	"airoha/EthMD32.DSP.bin"
+
+struct en8811_phy {
+	struct air_mdio	*ep_mdio;
