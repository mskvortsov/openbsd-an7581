+#include <dev/fdt/airpcsvar.h>
+#include <dev/fdt/airgpiovar.h>
+#include <dev/fdt/en8811var.h>
+
+#if NBPFILTER > 0
+#include <net/bpf.h>
+#endif
+
+#include <netinet/in.h>
+#include <netinet/if_ether.h>
+
+/* SCU registers */
+#define SCU_SHARE_FEMEM_SEL		0x0958
+
+/* FE registers */
+#define FE_DMA_GLO_CFG			0x0000
+#define  FE_DMA_GLO_L2_SPACE_MASK	(0xfU << 4)
+#define  FE_DMA_GLO_L2_SPACE(x)		((x) << 4)
+#define  FE_DMA_GLO_PAGE_128		(1U << 3)
+#define FE_RST_GLO_CFG			0x0004
+#define  FE_RST_CORE			(1U << 0)
+#define  FE_RST_GDM3_MBI_ARB		(1U << 2)
+#define  FE_RST_GDM4_MBI_ARB		(1U << 3)
+#define FE_WAN_PORT			0x0024
+#define FE_CDM1_OQ_MAP(n)			(0x0050 + (n) * 4)
+#define FE_PCE_CFG			0x0070
+#define FE_PSE_QUEUE_CFG		0x0080
+#define  FE_PSE_QUEUE_PORT(x)		((x) << 24)
+#define  FE_PSE_QUEUE_ID(x)		((x) << 16)
+#define  FE_PSE_QUEUE_WRITE		(1U << 8)
+#define  FE_PSE_QUEUE_OQRSV		(1U << 0)
+#define FE_PSE_QUEUE_VAL		0x0084
+#define FE_PSE_FQ_CFG			0x008c
+#define  FE_PSE_FQ_LIMIT_MASK		0x7fff
+#define FE_PSE_BUF_SET			0x0090
+#define FE_PSE_SHARE_THD		0x0094
+#define FE_PSE_IQ_REV1			0x0108
+#define FE_PSE_IQ_REV2			0x010c
+#define FE_VIP_PORT_EN			0x01f0
+#define FE_IFC_PORT_EN			0x01f4
+#define FE_IFC_CFG			0x0200
+#define FE_VIP_EN(n)			(0x0300 + (n) * 8)
+#define FE_CDM_BASE(n)			((n) == 1 ? 0x0400 : 0x1400)
+#define FE_CDM_VLAN_CTRL(n)		FE_CDM_BASE(n)
+#define FE_CDM_FWD_CFG(n)			(FE_CDM_BASE(n) + 0x08)
+#define FE_CDM_CRSN_QSEL(n, m)		(FE_CDM_BASE(n) + 0x10 + (m) * 4)
+#define FE_CDM_LRO_EN(n)			(FE_CDM_BASE(n) + 0x80)
+#define FE_PPE_GLO_CFG(n)			((n) == 0 ? 0x0e00 : 0x1e00)
+#define FE_MC_VLAN_EN			0x2100
+#define FE_SP_DFT_CPORT(n)		(0x20e0 + (n) * 4)
+#define FE_GDM_BASE(x)			((x) == 4 ? 0x2500 : (x) == 3 ? 0x1100 : \
+					    (x) == 2 ? 0x1500 : 0x0500)
+#define FE_GDM_FWD_CFG(x)		FE_GDM_BASE(x)
+#define  FE_GDM_FWD_CFG_STRIP_CRC	(1U << 16)
+#define  FE_GDM_FWD_CFG_DROP_CRC_ERR	(1U << 23)
+#define  FE_GDM_FWD_CFG_QSEL_MASK	0xffff	/* uc/bc/mc/other dest ports */
+#define  FE_GDM_FWD_CFG_DROP		0xffff	/* all of them to PSE port 15 */
+#define FE_GDM_INGRESS_CFG(x)		(FE_GDM_FWD_CFG(x) + 0x10)
+#define  FE_GDM_INGRESS_STAG_EN		(1U << 0)
+#define  FE_GDM_INGRESS_FC_EN		(1U << 1)
+#define FE_GDM_LEN_CFG(x)		(FE_GDM_FWD_CFG(x) + 0x14)
+#define  FE_GDM_LEN_SHORT_MASK		(0x3fffU << 0)
+#define  FE_GDM_LEN_SHORT(x)		((x) << 0)
+#define  FE_GDM_LEN_LONG_MASK		(0x3fffU << 16)
+#define  FE_GDM_LEN_LONG(x)		((x) << 16)
+#define FE_GDM_LPBK_CFG(x)		(FE_GDM_BASE(x) + 0x1c)
+#define FE_GDM_SRC_PORT_SET(x)		(FE_GDM_BASE(x) + 0x23c)
+#define  FE_GDM_SPORT_OFFSET_MASK	(0xfffU << 8)
+#define  FE_GDM_SPORT_OFFSET_8		(0x888U << 8)
+#define FE_CPORT_CFG			0x0540
+#define  FE_CPORT_PAD			(1U << 26)
+#define  FE_CPORT_PORT_XFC		(1U << 25)
+#define FE_CDM_NCRSN_QSEL		8	/* 32 reasons, 4 per register */
+/* MIB counters, relative to FE_GDM_BASE() */
+#define FE_GDM_TX_OK_PKT_CNT		0x0104
+#define FE_GDM_TX_ETH_PKT_CNT		0x0110
+#define FE_GDM_TX_ETH_DROP_CNT		0x0118
+#define FE_GDM_RX_OK_PKT_CNT		0x0148
+#define FE_GDM_RX_FC_DROP_CNT		0x014c
+#define FE_GDM_RX_RC_DROP_CNT		0x0150
+#define FE_GDM_RX_OVERFLOW_DROP_CNT	0x0154
+#define FE_GDM_RX_ERROR_DROP_CNT	0x0158
+#define FE_GDM_RX_ETH_PKT_CNT		0x0160
+#define FE_GDM_RX_ETH_DROP_CNT		0x0168
+#define FE_GDM_RX_ETH_BC_CNT		0x016c
+#define  FE_GDM_FWD_CFG_PAD_EN		(1U << 28)
+
+/* QDMA registers */
+#define QDMA_GLOBAL_CFG			0x0004
+#define  QDMA_GLOBAL_CFG_DMA_PREF(x)	((x) << 29)
+#define  QDMA_GLOBAL_CFG_CPU_TXR_RR	(1U << 28)
+#define  QDMA_GLOBAL_CFG_PAYLOAD_SWAP	(1U << 26)
+#define  QDMA_GLOBAL_CFG_IRQ0_EN	(1U << 19)
+#define  QDMA_GLOBAL_CFG_TX_WB_DONE	(1U << 6)
+#define  QDMA_GLOBAL_CFG_MAX_ISSUE(x)	((x) << 4)
+#define  QDMA_GLOBAL_CFG_RX_DMA_BUSY	(1U << 3)
+#define  QDMA_GLOBAL_CFG_RX_DMA_EN	(1U << 2)
+#define  QDMA_GLOBAL_CFG_TX_DMA_BUSY	(1U << 1)
+#define  QDMA_GLOBAL_CFG_TX_DMA_EN	(1U << 0)
+#define QDMA_FWD_DSCP_BASE		0x0010
+#define QDMA_FWD_BUF_BASE		0x0014
+#define QDMA_HW_FWD_DSCP_CFG		0x0018
+#define  QDMA_HW_FWD_DSCP_PAYLOAD_MASK	(0x3U << 28)
+#define  QDMA_HW_FWD_DSCP_MIN_SCAT_MASK	0xffff
+#define QDMA_INT_STATUS0		0x0020
+#define QDMA_INT_STATUS1		0x0024
+#define QDMA_INT_ENABLE0		0x0028
+#define QDMA_INT_ENABLE1		0x002c
+#define QDMA_INT_STATUS(n)		((n) == 4 ? 0x0730 : \
+					(n) >= 2 ? 0x0720 + ((n) - 2) * 4 : \
+					0x0020 + (n) * 4)
+#define QDMA_INT_ENABLE(b, n)		((n) == 4 ? 0x0750 + (b) * 32 : \
+					(n) >= 2 ? 0x0740 + (b) * 32 + \
+					((n) - 2) * 4 : 0x0028 + (b) * 8 + (n) * 4)
+#define  QDMA_INT0_IRQ0_FULL		(1U << 1)
+#define  QDMA_INT0_IRQ0			(1U << 0)
+#define  QDMA_INT1_RX0_DONE		(1U << 0)
+#define QDMA_TX_IRQ_BASE		0x0050
+#define QDMA_TX_IRQ1_BASE		0x0048
+#define QDMA_TX_IRQ1_CFG			0x004c
+#define QDMA_TX_IRQ_CFG			0x0054
+#define  QDMA_TX_IRQ_THR(x)		((x) << 16)
+#define  QDMA_TX_IRQ_DEPTH(x)		((x) << 0)
+#define QDMA_IRQ_CLEAR_LEN		0x0058
+#define QDMA_IRQ_STATUS			0x005c
+#define QDMA_IRQ1_CLEAR_LEN		0x0064
+#define QDMA_IRQ1_STATUS			0x0068
+#define  QDMA_IRQ_STATUS_ENTRY_LEN(x)	(((x) >> 16) & 0xfff)
+#define  QDMA_IRQ_STATUS_HEAD(x)	((x) & 0xfff)
+#define QDMA_TX_RING_BASE		0x0100
+#define QDMA_TX_RING_BLOCKING		0x0104
+#define QDMA_TX_CPU_IDX			0x0108
+#define QDMA_TX_DMA_IDX			0x010c
+#define QDMA_TXN(n, reg)			((n) < 8 ? (reg) + ((n) << 5) : \
+					(reg) + 0x0a00 + (((n) - 8) << 5))
+#define QDMA_NTXRINGS			32
+#define QDMA_QUEUE_CLOSE(n)		(0x00a0 + (n) * 4)
+#define QDMA_RX_RING_BASE		0x0200
+#define QDMA_RX_RING_SIZE		0x0204
+#define  QDMA_RX_RING_THR(x)		((x) << 16)
+#define QDMA_RX_CPU_IDX			0x0208
+#define QDMA_RX_DMA_IDX			0x020c
+#define QDMA_RX_DELAY_INT		0x0210
+#define QDMA_RX_SCATTER_CFG		0x0214
+/* Per ring n of 32; the QDMA_RX_* above are ring 0. */
+#define QDMA_RXN(n, reg)		((n) < 16 ? (reg) + ((n) << 5) : \
+					    (reg) + 0x0c00 + (((n) - 16) << 5))
+#define QDMA_NRXRINGS			32
+#define  QDMA_RX_IDX_MASK		0xffff
+#define QDMA_LMGR_INIT_CFG		0x1000
+#define  QDMA_LMGR_INIT_START		(1U << 31)
+#define  QDMA_LMGR_SRAM_MODE		(1U << 30)
+#define  QDMA_LMGR_DESC_NUM_MASK	0x1ffff
+#define QDMA_FWD_DSCP_LOW_THR		0x1004
+#define QDMA_INGRESS_TRTCM_CFG		0x0070
+#define QDMA_EGRESS_RATE_METER_CFG	0x100c
+#define QDMA_EGRESS_TRTCM_CFG		0x1010
+#define QDMA_CHAN_QOS_MODE(n)		(0x1040 + (n) * 4)
+#define  QDMA_CHAN_QOS_MODE_SP		0x11111111U
+#define QDMA_NQOSREGS			4	/* eight channels per register */
+#define QDMA_GLB_TRTCM_CFG		0x1080
+#define QDMA_TXQ_CNGST_CFG		0x10a0
+#define QDMA_SLA_TRTCM_CFG		0x1150
+
+/* QDMA descriptor */
+struct aireth_desc {
+	uint32_t	rsv;
+	uint32_t	ctrl;
+#define AIRETH_CTRL_DONE		(1U << 31)
+#define AIRETH_CTRL_DROP		(1U << 30)
+#define AIRETH_CTRL_MORE		(1U << 29)
+#define AIRETH_CTRL_LEN_MASK		0xffff
+	uint32_t	addr;
+	uint32_t	data;
+#define AIRETH_DATA_NEXT_ID_MASK	0xffff
+	uint32_t	msg0;
+	uint32_t	msg1;
+#define AIRETH_TXMSG1_METER(x)		((x) << 24)
+#define AIRETH_TXMSG1_FPORT(x)		((x) << 20)
+#define AIRETH_RXMSG1_SPORT(x)		(((x) >> 21) & 0x1f)
+#define  AIRETH_SPORT_GDM1_MIN		0x10	/* .. 0x14 */
+#define  AIRETH_SPORT_GDM1_MAX		0x14
+#define  AIRETH_SPORT_GDM4		0x18	/* HSGMII ETH serdes */
+	uint32_t	msg2;
+	uint32_t	msg3;
+};
+
+/* QDMA hardware forwarding descriptor */
+struct aireth_fwd_desc {
+	uint32_t	data[8];
+};
+
+#define AIRETH_FE_PORT_GDM1	1
+#define AIRETH_FE_PORT_GDM4	9
+
+#define AIRETH_NPORTS		2	/* GDM1 (switch), GDM4 (lan1/WAN) */
+
+#define AIRETH_NTXDESC		256
+#define AIRETH_NTXSEGS		16
+#define AIRETH_NRXDESC		256
+#define AIRETH_NIRQ		256
+#define AIRETH_NFWDDESC		256
+#define AIRETH_FWDBUFSZ		2048
+
+struct aireth_buf {
+	bus_dmamap_t	tb_map;
+	struct mbuf	*tb_m;
+};
+
+struct aireth_dmamem {
+	bus_dmamap_t		tdm_map;
+	bus_dma_segment_t	tdm_seg;
+	size_t			tdm_size;
+	caddr_t			tdm_kva;
+};
+#define AIRETH_DMA_MAP(_tdm)	((_tdm)->tdm_map)
+#define AIRETH_DMA_LEN(_tdm)	((_tdm)->tdm_size)
+#define AIRETH_DMA_DVA(_tdm)	((_tdm)->tdm_map->dm_segs[0].ds_addr)
+#define AIRETH_DMA_KVA(_tdm)	((void *)(_tdm)->tdm_kva)
+
+struct aireth_softc;
+
+/*
+ * A QDMA Tx queue.  QDMA0 serves the LAN (GDM1) and all of Rx; the
+ * frame engine only delivers frames to GDM4 (lan1/WAN) from QDMA1, as
+ * Linux uses it, so that one is set up for Tx only.
+ */
+struct aireth_txq {
+	struct aireth_softc	*q_sc;
+	int			 q_id;		/* QDMA index */
+	bus_space_handle_t	 q_ioh;
+	struct aireth_dmamem	*q_ring;
+	struct aireth_buf	*q_buf;
+	struct aireth_desc	*q_desc;
+	int			 q_prod;
+	int			 q_cons;
+	struct aireth_dmamem	*q_irqring;	/* Tx completion queue */
+	uint32_t		*q_irq;
+	struct aireth_dmamem	*q_fwddesc;	/* hw forwarding link mgr */
+	struct aireth_dmamem	*q_fwdbuf;
+	struct mutex		 q_mtx;
+	void			*q_ih;
+};
+
+struct aireth_port {
+	struct aireth_softc	*ap_sc;
+	int			 ap_gdm;	/* GDM index, 1 or 4 */
+	int			 ap_fport;	/* PSE port for Tx */
+	struct aireth_txq	*ap_txq;
+	int			 ap_phy;	/* MDIO address, -1 internal */
+	int			 ap_phynode;
+	int			 ap_node;
+	int			 ap_pcsnode;
+	struct airpcs_softc	*ap_pcs;
+	struct en8811_phy	 ap_phydev;
+	struct arpcom		 ap_ac;
+	struct ifmedia		 ap_media;
+	uint64_t		 ap_active;	/* current media */
+	struct timeout		 ap_tick;	/* link poll */
+};
+
+struct aireth_softc {
+	struct device		sc_dev;
+	int			sc_node;
+	bus_space_tag_t		sc_iot;
+	bus_space_handle_t	sc_fe_ioh;
+	bus_size_t		sc_fe_iosize;
+	bus_space_handle_t	sc_qdma_ioh;
+	bus_dma_tag_t		sc_dmat;
+	void			*sc_ih;
+
+	struct aireth_port	sc_ports[AIRETH_NPORTS];
+	int			sc_nports;
+	int			sc_nup;		/* ports up; rings run if > 0 */
+	int			sc_dma_failed;	/* stopped DMA could still own buffers */
+	struct aireth_txq	sc_txq[2];
+	int			sc_ntxq;
+
+	struct aireth_dmamem	*sc_rxring;
+	struct aireth_buf	*sc_rxbuf;
+	struct aireth_desc	*sc_rxdesc;
+	int			sc_rx_prod;
+	struct if_rxring	sc_rx_ring;
+	int			sc_rx_cons;
+	struct mbuf		*sc_rx_head;	/* frame being reassembled */
+	struct mbuf		*sc_rx_tail;
+	int			sc_rx_port;	/* ... and its port */
+
+	struct timeout		sc_rxto;
+	struct mutex		sc_rx_mtx;	/* Rx ring: intr vs. poll */
+	u_int			sc_rxpoll_hits;	/* frames the poll found */
+	u_int			sc_rxerr_len;	/* Rx errors by cause */
+	u_int			sc_rxerr_big;
+	u_int			sc_rxfrags;	/* frames in several buffers */
+	u_int			sc_rxsport[32];	/* frames by source port */
+	uint16_t		sc_rxfraglen[8];	/* last fragment lengths */
+	int			sc_rxfragidx;
+};
+
+#define DEVNAME(_s)	((_s)->sc_dev.dv_xname)
+
