+/*
+ * Airoha EN7581 System Control Unit.  Only the reset controller is
+ * implemented; the clocks are left as configured by the firmware.
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+
+#include <machine/intr.h>
+#include <machine/bus.h>
+#include <machine/fdt.h>
+
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/ofw_clock.h>
+#include <dev/ofw/ofw_misc.h>
+#include <dev/ofw/fdt.h>
+
+/* Registers */
+#define SCU_PCIC		0x0088
+#define SCU_RST_CTRL2		0x0830
+#define SCU_RST_CTRL1		0x0834
+
+#define HREAD4(sc, reg)							\
+	(bus_space_read_4((sc)->sc_iot, (sc)->sc_ioh, (reg)))
+#define HWRITE4(sc, reg, val)						\
+	bus_space_write_4((sc)->sc_iot, (sc)->sc_ioh, (reg), (val))
+
+/*
+ * Map from the reset index used in the device tree to the register
+ * bit.  Bits 0-31 live in RST_CTRL2, bits 32-63 in RST_CTRL1 and bits
+ * 64-95 in PCIC (where the polarity is inverted).
+ */
+const uint8_t airscu_en7581_resets[] = {
+	/* RST_CTRL2 */
+	0,		/* XPON_PHY */
+	2,		/* CPU_TIMER2 */
+	3,		/* HSUART */
+	4,		/* UART4 */
+	5,		/* UART5 */
+	6,		/* I2C2 */
+	7,		/* XSI_MAC */
+	8,		/* XSI_PHY */
+	9,		/* NPU */
+	10,		/* I2S */
+	11,		/* TRNG */
+	12,		/* TRNG_MSTART */
+	13,		/* DUAL_HSI0 */
+	14,		/* DUAL_HSI1 */
+	15,		/* HSI */
+	16,		/* DUAL_HSI0_MAC */
+	17,		/* DUAL_HSI1_MAC */
+	18,		/* HSI_MAC */
+	19,		/* WDMA */
+	20,		/* WOE0 */
+	21,		/* WOE1 */
+	22,		/* HSDMA */
+	24,		/* TDMA */
+	25,		/* EMMC */
+	26,		/* SOE */
+	27,		/* PCIE2 */
+	28,		/* XFP_MAC */
+	29,		/* USB_HOST_P1 */
+	30,		/* USB_HOST_P1_U3_PHY */
+	/* RST_CTRL1 */
+	32 + 0,		/* PCM1_ZSI_ISI */
+	32 + 1,		/* FE_PDMA */
+	32 + 2,		/* FE_QDMA */
+	32 + 4,		/* PCM_SPIWP */
+	32 + 6,		/* CRYPTO */
+	32 + 8,		/* TIMER */
+	32 + 11,	/* PCM1 */
+	32 + 12,	/* UART */
+	32 + 13,	/* GPIO */
+	32 + 14,	/* GDMA */
+	32 + 16,	/* I2C_MASTER */
+	32 + 17,	/* PCM2_ZSI_ISI */
+	32 + 18,	/* SFC */
+	32 + 19,	/* UART2 */
+	32 + 20,	/* GDMP */
+	32 + 21,	/* FE */
+	32 + 22,	/* USB_HOST_P0 */
+	32 + 23,	/* GSW */
+	32 + 25,	/* SFC2_PCM */
+	32 + 26,	/* PCIE0 */
+	32 + 27,	/* PCIE1 */
+	32 + 28,	/* CPU_TIMER */
+	32 + 29,	/* PCIE_HB */
+	32 + 31,	/* XPON_MAC */
+	/* PCIC */
+	64 + 29,	/* PCIC_PERSTOUT0 */
+	64 + 26,	/* PCIC_PERSTOUT1 */
+	64 + 16,	/* PCIC_PERSTOUT2 */
+};
+
+struct airscu_softc {
+	struct device		sc_dev;
+	bus_space_tag_t		sc_iot;
+	bus_space_handle_t	sc_ioh;
+
+	struct reset_device	sc_rd;
+};
+
+int	airscu_match(struct device *, void *, void *);
+void	airscu_attach(struct device *, struct device *, void *);
+
+const struct cfattach airscu_ca = {
+	sizeof (struct airscu_softc), airscu_match, airscu_attach
+};
+
+struct cfdriver airscu_cd = {
+	NULL, "airscu", DV_DULL
+};
+
+void	airscu_reset(void *, uint32_t *, int);
+
+int
+airscu_match(struct device *parent, void *match, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	/* Take precedence over syscon(4). */
+	if (OF_is_compatible(faa->fa_node, "airoha,en7581-scu"))
+		return 10;
+	return 0;
+}
+
+void
+airscu_attach(struct device *parent, struct device *self, void *aux)
+{
+	struct airscu_softc *sc = (struct airscu_softc *)self;
+	struct fdt_attach_args *faa = aux;
+
+	if (faa->fa_nreg < 1) {
+		printf(": no registers\n");
+		return;
+	}
+
+	sc->sc_iot = faa->fa_iot;
+	if (bus_space_map(sc->sc_iot, faa->fa_reg[0].addr,
+	    faa->fa_reg[0].size, 0, &sc->sc_ioh)) {
+		printf(": can't map registers\n");
+		return;
+	}
+
+	printf("\n");
+
+	/* Other drivers poke at SCU registers through the regmap. */
+	regmap_register(faa->fa_node, sc->sc_iot, sc->sc_ioh,
+	    faa->fa_reg[0].size);
+
+	sc->sc_rd.rd_node = faa->fa_node;
+	sc->sc_rd.rd_cookie = sc;
+	sc->sc_rd.rd_reset = airscu_reset;
+	reset_register(&sc->sc_rd);
+}
+
+void
+airscu_reset(void *cookie, uint32_t *cells, int assert)
+{
+	struct airscu_softc *sc = cookie;
+	uint32_t idx = cells[0];
+	bus_size_t reg;
+	uint32_t bit, val;
+
+	if (idx >= nitems(airscu_en7581_resets)) {
+		printf("%s: 0x%08x\n", __func__, idx);
+		return;
+	}
+
+	bit = airscu_en7581_resets[idx];
+	switch (bit / 32) {
+	case 0:
+		reg = SCU_RST_CTRL2;
+		break;
+	case 1:
+		reg = SCU_RST_CTRL1;
+		break;
+	default:
+		reg = SCU_PCIC;
+		assert = !assert;
+		break;
+	}
+	bit = 1U << (bit % 32);
+
+	val = HREAD4(sc, reg);
+	if (assert)
+		val |= bit;
+	else
+		val &= ~bit;
+	HWRITE4(sc, reg, val);
+}
