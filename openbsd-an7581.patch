diff --git a/dev/fdt/airgpio.c b/dev/fdt/airgpio.c
new file mode 100644
index 0000000..3f53317
--- /dev/null
+++ b/dev/fdt/airgpio.c
@@ -0,0 +1,419 @@
+/*	$OpenBSD$	*/
+/*
