+/* AN7581 Ethernet PCS: the fixed 2500BASE-X link to the EN8811H. */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+#include <sys/kernel.h>
+#include <sys/mutex.h>
+
+#include <machine/bus.h>
+#include <machine/fdt.h>
+
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/ofw_clock.h>
+#include <dev/ofw/ofw_misc.h>
+#include <dev/ofw/fdt.h>
+#include <dev/fdt/airpcsvar.h>
+
+enum {
+	AIRPCS_MAC, AIRPCS_AN, AIRPCS_PCS, AIRPCS_MULTI, AIRPCS_USX,
+	AIRPCS_RATE, AIRPCS_ANA, AIRPCS_PMA, AIRPCS_NBANKS
+};
+#define AIRPCS_DELAY		255
+#define AIRPCS_SCU_REV		0x005c
+#define AIRPCS_SCU_XSI		0x0094
+#define  AIRPCS_SCU_XSI_MASK	(3U << 13)
+#define  AIRPCS_SCU_HSGMII	(2U << 13)
+#define AIRPCS_MAC_CFG		0x000
+#define  AIRPCS_MAC_STOP		0x0000000f
+#define  AIRPCS_MAC_FC		0x00000030
+#define  AIRPCS_MAC_FRAG_IPG	0x07fe2800
+#define AIRPCS_AN_CTRL		0x000
+#define  AIRPCS_AN_RESET		(1U << 15)
+#define  AIRPCS_AN_ENABLE		(1U << 12)
+#define AIRPCS_AN_STATUS		0x004
+#define  AIRPCS_LINK		(1U << 2)
+#define AIRPCS_MULTI_MODE		0x018
+#define AIRPCS_PMA_RESET		0x460
+#define  AIRPCS_TXPCS_RESET_N	(1U << 10)
+#define AIRPCS_FREQDET		0x530
+#define  AIRPCS_FREQ_LOCK		(1U << 0)
+#define AIRPCS_IDAC		0x794
+#define AIRPCS_FLL_IDAC		0x174
+#define AIRPCS_FREQ_CTRL		0x158
+#define AIRPCS_CAL_TARGET		0xa000
+#define AIRPCS_CAL_WINDOW		100
+#define AIRPCS_CAL_TRIES		10
+
+struct airpcs_step {
+	uint8_t		bank;
+	uint16_t	reg;
+	uint32_t	mask;
+	uint32_t	value;
+};
+
+#include <dev/fdt/airpcstables.h>
+
+struct airpcs_softc {
+	struct device		sc_dev;
+	bus_space_tag_t		sc_iot;
+	bus_space_handle_t	sc_ioh[AIRPCS_NBANKS];
+	bus_size_t		sc_size[AIRPCS_NBANKS];
+	struct regmap		*sc_scu;
+	struct mutex		sc_lock;
+	int			sc_node;
+	unsigned int		sc_rev;
+	int			sc_busy;
+	int			sc_ready;
+	int			sc_link;
+	unsigned int		sc_idac;
+	unsigned int		sc_recoveries;
+};
+
+int	airpcs_match(struct device *, void *, void *);
+void	airpcs_attach(struct device *, struct device *, void *);
+int	airpcs_update(struct airpcs_softc *, unsigned int, unsigned int,
+	    uint32_t, uint32_t);
+int	airpcs_apply(struct airpcs_softc *, const struct airpcs_step *, size_t,
+	    int);
+void	airpcs_wait(struct airpcs_softc *, unsigned int, int);
+int	airpcs_measure(struct airpcs_softc *, unsigned int, unsigned int *);
+int	airpcs_calibrate(struct airpcs_softc *);
+int	airpcs_config(struct airpcs_softc *);
+
+const struct cfattach airpcs_ca = {
+	sizeof(struct airpcs_softc), airpcs_match, airpcs_attach
+};
+
+struct cfdriver airpcs_cd = {
+	NULL, "airpcs", DV_DULL
+};
+
+#define R(sc, bank, reg) \
+	bus_space_read_4((sc)->sc_iot, (sc)->sc_ioh[(bank)], (reg))
+#define W(sc, bank, reg, val) \
+	bus_space_write_4((sc)->sc_iot, (sc)->sc_ioh[(bank)], (reg), (val))
+#define APPLY(sc, table, sleep) \
+	airpcs_apply((sc), (table), nitems(table), (sleep))
+
+int
+airpcs_match(struct device *parent, void *match, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	return OF_is_compatible(faa->fa_node, "airoha,an7581-pcs-eth");
+}
+
+void
+airpcs_attach(struct device *parent, struct device *self, void *aux)
+{
+	static const char *names[] = {
+		"pcs_mac", "hsgmii_an", "hsgmii_pcs", "multi_sgmii",
+		"usxgmii", "hsgmii_rate_adp", "pcs_ana", "pcs_pma"
+	};
+	static const bus_size_t minsize[] = {
+		0x104, 0x038, 0x108, 0x104, 0x004, 0x104, 0x400, 0x900
+	};
+	struct airpcs_softc *sc = (struct airpcs_softc *)self;
+	struct fdt_attach_args *faa = aux;
+	uint32_t phandle, resets[4], rev;
+	int n, idx;
+
+	phandle = OF_getpropint(faa->fa_node, "airoha,scu", 0);
+	sc->sc_scu = regmap_byphandle(phandle);
+	if (sc->sc_scu == NULL || phandle == 0 ||
+	    OF_getproplen(faa->fa_node, "resets") != sizeof(resets) ||
+	    OF_getpropintarray(faa->fa_node, "resets", resets,
+	    sizeof(resets)) != sizeof(resets) || resets[0] != phandle ||
+	    resets[2] != phandle ||
+	    OF_getindex(faa->fa_node, "mac", "reset-names") < 0 ||
+	    OF_getindex(faa->fa_node, "phy", "reset-names") < 0) {
+		printf(": missing SCU/reset controller\n");
+		return;
+	}
+	rev = regmap_read_4(sc->sc_scu, AIRPCS_SCU_REV);
+	if (rev == 0xdeadbeef || rev == 0xffffffff) {
+		printf(": can't read SoC revision\n");
+		return;
+	}
+	sc->sc_rev = rev & 0xffff;
+	sc->sc_iot = faa->fa_iot;
+	for (n = 0; n < AIRPCS_NBANKS; n++) {
+		idx = OF_getindex(faa->fa_node, names[n], "reg-names");
+		if (idx < 0 || idx >= faa->fa_nreg ||
+		    faa->fa_reg[idx].size < minsize[n]) {
+			printf(": missing or short %s registers\n", names[n]);
+			goto unmap;
+		}
+		sc->sc_size[n] = faa->fa_reg[idx].size;
+		if (bus_space_map(sc->sc_iot, faa->fa_reg[idx].addr,
+		    sc->sc_size[n], 0, &sc->sc_ioh[n])) {
+			printf(": can't map %s registers\n", names[n]);
+			goto unmap;
+		}
+	}
+	mtx_init(&sc->sc_lock, IPL_NET);
+	sc->sc_node = faa->fa_node;
+	printf(": AN7581 Ethernet PCS, rev %u, %s calibration\n", sc->sc_rev,
+	    sc->sc_rev < 2 ? "manual" : "automatic");
+	return;
+unmap:
+	while (n-- > 0)
+		bus_space_unmap(sc->sc_iot, sc->sc_ioh[n], sc->sc_size[n]);
+}
+
+struct airpcs_softc *
+airpcs_by_node(int node)
+{
+	struct airpcs_softc *sc;
+	int i;
+
+	if (node == 0)
+		return NULL;
+	for (i = 0; i < airpcs_cd.cd_ndevs; i++) {
+		sc = airpcs_cd.cd_devs[i];
+		if (sc != NULL && sc->sc_node == node)
+			return sc;
+	}
+	return NULL;
+}
+
+int
+airpcs_update(struct airpcs_softc *sc, unsigned int bank, unsigned int reg,
+    uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+
+	if (bank >= AIRPCS_NBANKS || (reg & 3) || sc->sc_size[bank] < 4 ||
+	    reg > sc->sc_size[bank] - 4)
+		return EINVAL;
+	old = R(sc, bank, reg);
+	if (old == 0xdeadbeef)
+		return EIO;
+	W(sc, bank, reg, (old & ~mask) | (value & mask));
+	return 0;
+}
+
+void
+airpcs_wait(struct airpcs_softc *sc, unsigned int usec, int can_sleep)
+{
+	if (can_sleep && usec >= 1000)
+		tsleep_nsec(sc, PWAIT, "airpcs", (uint64_t)usec * 1000);
+	else
+		delay(usec);
+}
+
+int
+airpcs_apply(struct airpcs_softc *sc, const struct airpcs_step *steps,
+    size_t count, int can_sleep)
+{
+	size_t i;
+	int error;
+
+	for (i = 0; i < count; i++) {
+		if (steps[i].bank == AIRPCS_DELAY) {
+			airpcs_wait(sc, steps[i].value, can_sleep);
+			continue;
+		}
+		error = airpcs_update(sc, steps[i].bank, steps[i].reg,
+		    steps[i].mask, steps[i].value);
+		if (error)
+			return error;
+	}
+	return 0;
+}
+
+int
+airpcs_measure(struct airpcs_softc *sc, unsigned int idac, unsigned int *diff)
+{
+	uint32_t val;
+	unsigned int freq;
+	int error;
+
+	if ((error = airpcs_update(sc, AIRPCS_PMA, AIRPCS_IDAC, 0x7ff, idac)) ||
+	    (error = airpcs_update(sc, AIRPCS_PMA, AIRPCS_FREQ_CTRL, 7, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_PMA, AIRPCS_FREQ_CTRL, 7, 3)))
+		return error;
+	airpcs_wait(sc, 5000, 1);
+	val = R(sc, AIRPCS_PMA, AIRPCS_FREQDET);
+	if (val == 0xdeadbeef || val == 0xffffffff)
+		return EIO;
+	freq = val >> 16;
+	*diff = freq > AIRPCS_CAL_TARGET ? freq - AIRPCS_CAL_TARGET :
+	    AIRPCS_CAL_TARGET - freq;
+	return 0;
+}
+
+/*
+ * Pre-E2 silicon needs an IDAC measured against 0xa000 +/- 100.
+ * Check all eight coarse bands, then all fine codes in the best band
+ * and its lower neighbour (fine tuning can cross the coarse boundary).
+ * The bounded search avoids assumptions about monotonic fine-code steps.
+ */
+int
+airpcs_calibrate(struct airpcs_softc *sc)
+{
+	unsigned int best = 0, bestdiff = UINT_MAX, diff, coarse, band, code;
+	unsigned int start, end;
+	int error;
+
+	if ((error = APPLY(sc, airpcs_cal_begin, 1)) != 0)
+		return error;
+	for (coarse = 0; coarse < 8; coarse++) {
+		if ((error = airpcs_measure(sc, coarse << 8, &diff)) != 0)
+			return error;
+		if (diff < bestdiff) {
+			best = coarse << 8;
+			bestdiff = diff;
+		}
+	}
+	band = best >> 8;
+	start = band ? band - 1 : 0;
+	end = band;
+	for (coarse = start; coarse <= end && bestdiff != 0; coarse++) {
+		for (code = 0; code < 256 && bestdiff != 0; code++) {
+			if ((error = airpcs_measure(sc, (coarse << 8) | code,
+			    &diff)) != 0)
+				return error;
+			if (diff < bestdiff) {
+				best = (coarse << 8) | code;
+				bestdiff = diff;
+			}
+		}
+	}
+	if (bestdiff > AIRPCS_CAL_WINDOW)
+		return ERANGE;
+	if ((error = airpcs_measure(sc, best, &diff)) != 0)
+		return error;
+	if (diff > AIRPCS_CAL_WINDOW)
+		return ERANGE;
+	if ((error = APPLY(sc, airpcs_cal_finish, 1)) ||
+	    (error = airpcs_update(sc, AIRPCS_PMA, AIRPCS_FLL_IDAC, 0x7ff, best)) ||
+	    (error = APPLY(sc, airpcs_cal_release, 1)))
+		return error;
+	sc->sc_idac = best;
+	return 0;
+}
+
+int
+airpcs_config(struct airpcs_softc *sc)
+{
+	int error;
+
+	/* 2500BASE-X: no Clause 37 negotiation, fixed host-side rate. */
+	if ((error = airpcs_update(sc, AIRPCS_MULTI, 0x100, 1U << 28, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_PCS, 0, 1U << 30, 1U << 30)) ||
+	    (error = airpcs_update(sc, AIRPCS_PCS, 0x20, 0x513, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_PCS, 0x20, 0xa2c, 0xa2c)) ||
+	    (error = airpcs_update(sc, AIRPCS_PCS, 0x20, 0xa2c, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_RATE, 0, 0x0c000011, 0x11)) ||
+	    (error = airpcs_update(sc, AIRPCS_MULTI, AIRPCS_MULTI_MODE, 0x37, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_RATE, 0x100, 1U << 31, 1U << 31)) ||
+	    (error = airpcs_update(sc, AIRPCS_AN, AIRPCS_AN_CTRL, AIRPCS_AN_ENABLE, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_PCS, 0x14, 1U << 4, 1U << 4)) ||
+	    (error = airpcs_update(sc, AIRPCS_AN, AIRPCS_AN_CTRL,
+	    AIRPCS_AN_RESET, AIRPCS_AN_RESET)))
+		return error;
+	return airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+	    0x07fefc30, AIRPCS_MAC_FRAG_IPG | AIRPCS_MAC_FC);
+}
+
+int
+airpcs_init(struct airpcs_softc *sc)
+{
+	uint32_t val;
+	int error, tries;
+
+	mtx_enter(&sc->sc_lock);
+	if (sc->sc_busy || sc->sc_ready) {
+		mtx_leave(&sc->sc_lock);
+		return EBUSY;
+	}
+	sc->sc_busy = 1;
+	mtx_leave(&sc->sc_lock);
+
+	val = regmap_read_4(sc->sc_scu, AIRPCS_SCU_XSI);
+	if (val == 0xdeadbeef || val == 0xffffffff) {
+		error = EIO;
+		goto fail;
+	}
+	reset_assert(sc->sc_node, "mac");
+	reset_assert(sc->sc_node, "phy");
+	regmap_write_4(sc->sc_scu, AIRPCS_SCU_XSI,
+	    (val & ~AIRPCS_SCU_XSI_MASK) | AIRPCS_SCU_HSGMII);
+	delay(10);
+	reset_deassert(sc->sc_node, "mac");
+	reset_deassert(sc->sc_node, "phy");
+	if ((error = airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+	    AIRPCS_MAC_STOP, AIRPCS_MAC_STOP)) ||
+	    (error = airpcs_update(sc, AIRPCS_MAC, 0x10, 1, 0)) ||
+	    (error = airpcs_update(sc, AIRPCS_MAC, 0x10, 1, 1)))
+		goto fail;
+	airpcs_wait(sc, 1000, 1);
+	if ((error = airpcs_update(sc, AIRPCS_MAC, 0x100, 1, 1)) ||
+	    (error = airpcs_update(sc, AIRPCS_ANA, 0, 1, 1)) ||
+	    (error = APPLY(sc, airpcs_jcpll, 1)))
+		goto fail;
+	delay(200);
+	if ((error = APPLY(sc, airpcs_txpll, 1)) != 0)
+		goto fail;
+	delay(200);
+	airpcs_wait(sc, 100000, 1);
+	if ((error = APPLY(sc, airpcs_txrx, 1)) != 0)
+		goto fail;
+	delay(100);
+	for (tries = 0; tries < AIRPCS_CAL_TRIES; tries++) {
+		if (sc->sc_rev < 2) {
+			if ((error = airpcs_apply(sc, airpcs_cdr, 1, 1)) ||
+			    (error = airpcs_calibrate(sc)) ||
+			    (error = airpcs_apply(sc, airpcs_cdr + 1,
+			    nitems(airpcs_cdr) - 1, 1)))
+				goto fail;
+		} else if ((error = APPLY(sc, airpcs_cdr, 1)) != 0)
+			goto fail;
+		if ((error = APPLY(sc, airpcs_global_reset, 1)) ||
+		    (error = APPLY(sc, airpcs_cdr, 1)))
+			goto fail;
+		val = R(sc, AIRPCS_PMA, AIRPCS_FREQDET);
+		if (val == 0xdeadbeef || val == 0xffffffff) {
+			error = EIO;
+			goto fail;
+		}
+		if (sc->sc_rev >= 2 || (val & AIRPCS_FREQ_LOCK))
+			break;
+	}
+	if (tries == AIRPCS_CAL_TRIES) {
+		error = ETIMEDOUT;
+		goto fail;
+	}
+	if ((error = airpcs_config(sc)) != 0)
+		goto fail;
+	mtx_enter(&sc->sc_lock);
+	sc->sc_ready = 1;
+	sc->sc_busy = 0;
+	sc->sc_link = 0;
+	mtx_leave(&sc->sc_lock);
+	return 0;
+fail:
+	airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+	    AIRPCS_MAC_STOP, AIRPCS_MAC_STOP);
+	reset_assert(sc->sc_node, "mac");
+	reset_assert(sc->sc_node, "phy");
+	mtx_enter(&sc->sc_lock);
+	sc->sc_busy = 0;
+	sc->sc_ready = 0;
+	sc->sc_link = 0;
+	mtx_leave(&sc->sc_lock);
+	return error;
+}
+
+void
+airpcs_down(struct airpcs_softc *sc)
+{
+	mtx_enter(&sc->sc_lock);
+	if (sc->sc_ready && airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+	    AIRPCS_MAC_STOP, AIRPCS_MAC_STOP))
+		sc->sc_ready = 0;
+	sc->sc_link = 0;
+	mtx_leave(&sc->sc_lock);
+}
+
+/* Return one only when copper and the PCS are both up; no sleeping here. */
+int
+airpcs_poll(struct airpcs_softc *sc, int copper_up)
+{
+	uint32_t val;
+	int i, signal = 0, error = 0, link = 0;
+
+	mtx_enter(&sc->sc_lock);
+	if (!sc->sc_ready)
+		goto out;
+	if (!copper_up)
+		goto down;
+	val = R(sc, AIRPCS_AN, AIRPCS_AN_STATUS);
+	if (val != 0xdeadbeef)
+		val = R(sc, AIRPCS_AN, AIRPCS_AN_STATUS);
+	if (val == 0xdeadbeef || val == 0xffffffff) {
+		error = EIO;
+		goto down;
+	}
+	if (!(val & AIRPCS_LINK)) {
+		if ((error = airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+		    AIRPCS_MAC_STOP, AIRPCS_MAC_STOP)) != 0)
+			goto down;
+		/* CDR can remain unlocked when the far end returns after LOS. */
+		if ((error = airpcs_update(sc, AIRPCS_PMA, 0x360,
+		    0x30000, 0x30000)) != 0)
+			goto down;
+		for (i = 0; i < 6; i++) {
+			val = R(sc, AIRPCS_PMA, 0x380);
+			if (val == 0xdeadbeef || val == 0xffffffff) {
+				error = EIO;
+				goto down;
+			}
+			if (val & (1U << 8))
+				signal++;
+		}
+		if (signal >= 4) {
+			error = APPLY(sc, airpcs_cdr, 0);
+			sc->sc_recoveries++;
+		}
+		goto down;
+	}
+	if (!sc->sc_link) {
+		/* Host link is always 2.5G, independently of the copper speed. */
+		if ((error = airpcs_update(sc, AIRPCS_MULTI,
+		    AIRPCS_MULTI_MODE, 0x34, 0x34)) ||
+		    (error = airpcs_update(sc, AIRPCS_PMA,
+		    AIRPCS_PMA_RESET, AIRPCS_TXPCS_RESET_N, 0)))
+			goto down;
+		delay(100);
+		if ((error = airpcs_update(sc, AIRPCS_PMA, AIRPCS_PMA_RESET,
+		    AIRPCS_TXPCS_RESET_N, AIRPCS_TXPCS_RESET_N)) ||
+		    (error = airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+		    AIRPCS_MAC_STOP, 0)))
+			goto down;
+	}
+	sc->sc_link = link = 1;
+	goto out;
+down:
+	if (airpcs_update(sc, AIRPCS_MAC, AIRPCS_MAC_CFG,
+	    AIRPCS_MAC_STOP, AIRPCS_MAC_STOP))
+		error = EIO;
+	sc->sc_link = 0;
+	if (error)
+		sc->sc_ready = 0;
+out:
+	mtx_leave(&sc->sc_lock);
+	return error ? -1 : link;
+}
+
+void
+airpcs_dump(struct airpcs_softc *sc)
+{
+	mtx_enter(&sc->sc_lock);
+	printf("%s: rev %u ready %d link %d idac 0x%x CDR resets %u "
+	    "an 0x%08x pma 0x%08x mac 0x%08x\n", sc->sc_dev.dv_xname,
+	    sc->sc_rev, sc->sc_ready, sc->sc_link, sc->sc_idac,
+	    sc->sc_recoveries, R(sc, AIRPCS_AN, AIRPCS_AN_STATUS),
+	    R(sc, AIRPCS_PMA, AIRPCS_FREQDET), R(sc, AIRPCS_MAC, AIRPCS_MAC_CFG));
+	mtx_leave(&sc->sc_lock);
+}
