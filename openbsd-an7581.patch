+	bus_space_read_4((sc)->sc_iot, (sc)->sc_fe_ioh, (reg))
+#define FE_WRITE(sc, reg, val)						\
+	bus_space_write_4((sc)->sc_iot, (sc)->sc_fe_ioh, (reg), (val))
+#define QDMA_READ(sc, reg)						\
+	bus_space_read_4((sc)->sc_iot, (sc)->sc_qdma_ioh, (reg))
+#define QDMA_WRITE(sc, reg, val)					\
+	bus_space_write_4((sc)->sc_iot, (sc)->sc_qdma_ioh, (reg), (val))
+#define TXQ_READ(q, reg)						\
+	bus_space_read_4((q)->q_sc->sc_iot, (q)->q_ioh, (reg))
+#define TXQ_WRITE(q, reg, val)						\
+	bus_space_write_4((q)->q_sc->sc_iot, (q)->q_ioh, (reg), (val))
