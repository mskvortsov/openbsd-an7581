+ * WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ * MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ * ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ * WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/* EN7581 GPIO and the pin states needed for external Ethernet MDIO. */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+#include <sys/kernel.h>
+#include <sys/mutex.h>
+
+#include <machine/bus.h>
+#include <machine/fdt.h>
+
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/ofw_gpio.h>
+#include <dev/ofw/ofw_misc.h>
+#include <dev/ofw/ofw_pinctrl.h>
+#include <dev/ofw/fdt.h>
+#include <dev/fdt/airgpiovar.h>
+
+#define AIRGPIO_NPINS		50
+#define AIRGPIO_DATA(n)		((n) < 32 ? 0x04 : 0x70)
+#define AIRGPIO_OE(n)		((n) < 32 ? 0x14 : 0x78)
+#define AIRGPIO_PWM(n)		((n) < 16 ? 0x34 : 0x68)
+#define AIRGPIO_PU(n)		((n) < 32 ? 0x4c : 0x54)
+#define AIRGPIO_PD(n)		((n) < 32 ? 0x50 : 0x58)
+#define AIRGPIO_MDC		0x214
+#define AIRGPIO_SPI		0x218
+#define AIRGPIO_PON		0x21c
+#define AIRGPIO_FORCE		0x228
+
+struct airgpio_softc {
+	struct device		sc_dev;
+	struct regmap		*sc_gpio;
+	struct regmap		*sc_chip;
+	struct mutex		sc_lock;
+	struct gpio_controller	sc_gc;
+	int			sc_node;
+};
+
+int	airgpio_match(struct device *, void *, void *);
+void	airgpio_attach(struct device *, struct device *, void *);
+void	airgpio_config_pin(void *, uint32_t *, int);
+int	airgpio_get_pin(void *, uint32_t *);
+void	airgpio_set_pin(void *, uint32_t *, int);
+int	airgpio_pinctrl(uint32_t, void *);
+int	airgpio_state(struct airgpio_softc *, int, int);
+int	airgpio_update(struct regmap *, unsigned int, uint32_t, uint32_t);
+int	airgpio_config(struct airgpio_softc *, unsigned int, int);
+int	airgpio_set(struct airgpio_softc *, unsigned int, int);
+int	airgpio_get(struct airgpio_softc *, unsigned int);
+int	airgpio_pin(const char *);
+void	airgpio_wait(struct airgpio_softc *, unsigned int);
+
+const struct cfattach airgpio_ca = {
+	sizeof(struct airgpio_softc), airgpio_match, airgpio_attach
+};
+
+struct cfdriver airgpio_cd = {
+	NULL, "airgpio", DV_DULL
+};
+
+int
+airgpio_match(struct device *parent, void *match, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	return OF_is_compatible(faa->fa_node, "airoha,en7581-pinctrl");
+}
+
+void
+airgpio_attach(struct device *parent, struct device *self, void *aux)
+{
+	struct airgpio_softc *sc = (struct airgpio_softc *)self;
+	struct fdt_attach_args *faa = aux;
+	uint32_t phandle, ranges[4];
+
+	sc->sc_gpio = regmap_bynode(OF_parent(faa->fa_node));
+	phandle = OF_getpropint(faa->fa_node, "airoha,chip-scu", 0);
+	if (phandle)
+		sc->sc_chip = regmap_byphandle(phandle);
+	else
+		sc->sc_chip = regmap_bycompatible("airoha,en7581-chip-scu");
+	if (sc->sc_gpio == NULL || sc->sc_chip == NULL) {
+		printf(": missing GPIO/chip SCU registers\n");
+		return;
+	}
+	if (OF_getpropint(faa->fa_node, "#gpio-cells", 0) != 2 ||
+	    OF_getpropint(faa->fa_node, "phandle", 0) == 0) {
+		printf(": invalid GPIO binding\n");
+		return;
+	}
+	/* GPIO numbers start at zero; pinctrl's pad numbers start at 13. */
+	if (OF_getpropintarray(faa->fa_node, "gpio-ranges", ranges,
+	    sizeof(ranges)) != sizeof(ranges) || ranges[1] != 0 ||
+	    ranges[2] != 13 || ranges[3] != AIRGPIO_NPINS ||
+	    OF_getnodebyphandle(ranges[0]) != faa->fa_node) {
+		printf(": unsupported GPIO ranges\n");
+		return;
+	}
+	mtx_init(&sc->sc_lock, IPL_HIGH);
+	sc->sc_node = faa->fa_node;
+	sc->sc_gc.gc_node = faa->fa_node;
+	sc->sc_gc.gc_cookie = sc;
+	sc->sc_gc.gc_config_pin = airgpio_config_pin;
+	sc->sc_gc.gc_get_pin = airgpio_get_pin;
+	sc->sc_gc.gc_set_pin = airgpio_set_pin;
+	printf(": %d GPIOs\n", AIRGPIO_NPINS);
+	pinctrl_register(faa->fa_node, airgpio_pinctrl, sc);
+	gpio_controller_register(&sc->sc_gc);
+}
+
+int
+airgpio_update(struct regmap *map, unsigned int reg, uint32_t mask,
+    uint32_t value)
+{
+	uint32_t old = regmap_read_4(map, reg);
+
+	if (old == 0xdeadbeef)
+		return EIO;
+	regmap_write_4(map, reg, (old & ~mask) | (value & mask));
+	return 0;
+}
+
+/* The caller holds sc_lock.  GPIO direction uses TWO bits per pin. */
+int
+airgpio_config(struct airgpio_softc *sc, unsigned int pin, int config)
+{
+	static const unsigned int dir[] = { 0x00, 0x20, 0x60, 0x64 };
+	unsigned int pwm, shift;
+	uint32_t bit;
+	int error;
+
+	if (pin >= AIRGPIO_NPINS ||
+	    (config & ~(GPIO_CONFIG_OUTPUT | GPIO_CONFIG_PULL_UP |
+	    GPIO_CONFIG_PULL_DOWN)) ||
+	    (config & (GPIO_CONFIG_PULL_UP | GPIO_CONFIG_PULL_DOWN)) ==
+	    (GPIO_CONFIG_PULL_UP | GPIO_CONFIG_PULL_DOWN))
+		return EINVAL;
+	if (pin >= 47 &&
+	    (config & (GPIO_CONFIG_PULL_UP | GPIO_CONFIG_PULL_DOWN)))
+		return EOPNOTSUPP;
+	bit = 1U << (pin % 32);
+	/* Disable this pin's PWM override; GPIO32..35 have no PWM bit. */
+	if (pin < 32 || pin >= 36) {
+		pwm = pin < 16 ? pin : pin < 32 ? pin - 16 : pin - 20;
+		if ((error = airgpio_update(sc->sc_gpio, AIRGPIO_PWM(pin),
+		    1U << pwm, 0)) != 0)
+			return error;
+	}
+	if (pin >= 47) {
+		pwm = pin == 49 ? 12 : pin - 38;
+		if ((error = airgpio_update(sc->sc_chip, AIRGPIO_PON,
+		    1U << pwm, 1U << pwm)) != 0)
+			return error;
+	}
+	if (config & (GPIO_CONFIG_PULL_UP | GPIO_CONFIG_PULL_DOWN)) {
+		if ((error = airgpio_update(sc->sc_chip, AIRGPIO_PU(pin),
+		    bit, config & GPIO_CONFIG_PULL_UP ? bit : 0)) ||
+		    (error = airgpio_update(sc->sc_chip, AIRGPIO_PD(pin),
+		    bit, config & GPIO_CONFIG_PULL_DOWN ? bit : 0)))
+			return error;
+	}
+	if ((error = airgpio_update(sc->sc_gpio, AIRGPIO_OE(pin), bit,
+	    config & GPIO_CONFIG_OUTPUT ? bit : 0)) != 0)
+		return error;
+	shift = 2 * (pin % 16);
+	return airgpio_update(sc->sc_gpio, dir[pin / 16], 3U << shift,
+	    config & GPIO_CONFIG_OUTPUT ? 1U << shift : 0);
+}
+
+int
+airgpio_set(struct airgpio_softc *sc, unsigned int pin, int value)
+{
+	uint32_t bit;
+
+	if (pin >= AIRGPIO_NPINS)
+		return EINVAL;
+	bit = 1U << (pin % 32);
+	return airgpio_update(sc->sc_gpio, AIRGPIO_DATA(pin), bit,
+	    value ? bit : 0);
+}
+
+int
+airgpio_get(struct airgpio_softc *sc, unsigned int pin)
+{
+	uint32_t val;
+
+	if (pin >= AIRGPIO_NPINS)
+		return -1;
+	val = regmap_read_4(sc->sc_gpio, AIRGPIO_DATA(pin));
+	if (val == 0xdeadbeef)
+		return -1;
+	return !!(val & (1U << (pin % 32)));
+}
+
+void
+airgpio_config_pin(void *cookie, uint32_t *cells, int config)
+{
+	struct airgpio_softc *sc = cookie;
+
+	if (cells[1] & ~GPIO_ACTIVE_LOW)
+		return;
+	mtx_enter(&sc->sc_lock);
+	airgpio_config(sc, cells[0], config);
+	mtx_leave(&sc->sc_lock);
+}
+
+int
+airgpio_get_pin(void *cookie, uint32_t *cells)
+{
+	struct airgpio_softc *sc = cookie;
+	int value;
+
+	if (cells[1] & ~GPIO_ACTIVE_LOW)
+		return 0;
+	mtx_enter(&sc->sc_lock);
+	value = airgpio_get(sc, cells[0]);
+	mtx_leave(&sc->sc_lock);
+	return value < 0 ? 0 : value ^ !!(cells[1] & GPIO_ACTIVE_LOW);
+}
+
+void
+airgpio_set_pin(void *cookie, uint32_t *cells, int value)
+{
+	struct airgpio_softc *sc = cookie;
+
+	if (cells[1] & ~GPIO_ACTIVE_LOW)
+		return;
+	mtx_enter(&sc->sc_lock);
+	airgpio_set(sc, cells[0], !!value ^ !!(cells[1] & GPIO_ACTIVE_LOW));
+	mtx_leave(&sc->sc_lock);
+}
+
+int
+airgpio_pin(const char *name)
+{
+	unsigned int pin = 0;
+
+	if (strncmp(name, "gpio", 4) != 0 || name[4] == '\0')
+		return -1;
+	for (name += 4; *name; name++) {
+		if (*name < '0' || *name > '9')
+			return -1;
+		pin = pin * 10 + *name - '0';
+		if (pin >= AIRGPIO_NPINS)
+			return -1;
+	}
+	return pin;
+}
+
+/* Validate before applying.  Unknown mux functions never report success. */
+int
+airgpio_state(struct airgpio_softc *sc, int node, int apply)
+{
+	char function[32], groups[32], pins[512];
+	int child, len, pos, pin, output, high, low, input, error;
+
+	if (!OF_is_enabled(node))
+		return ENODEV;
+	if (OF_child(node)) {
+		for (child = OF_child(node); child; child = OF_peer(child))
+			if ((error = airgpio_state(sc, child, apply)) != 0)
+				return error;
+		return 0;
+	}
+	len = OF_getproplen(node, "function");
+	if (len >= 0) {
+		memset(function, 0, sizeof(function));
+		memset(groups, 0, sizeof(groups));
+		if (len != sizeof("mdio") || OF_getprop(node, "function",
+		    function, sizeof(function)) != len || strcmp(function, "mdio"))
+			return EOPNOTSUPP;
+		len = OF_getproplen(node, "groups");
+		if (len != sizeof("mdio") || OF_getprop(node, "groups", groups,
+		    sizeof(groups)) != len || strcmp(groups, "mdio"))
+			return EINVAL;
+		if (!apply)
+			return 0;
+		/* Take GPIO1/2 back from I2C, PCM-SPI and PWM before MDC mode. */
+		if ((error = airgpio_update(sc->sc_chip, AIRGPIO_MDC,
+		    (1U << 14) | (1U << 13) | (1U << 11) | 1,
+		    1U << 14)) ||
+		    (error = airgpio_update(sc->sc_chip, AIRGPIO_SPI,
+		    (1U << 9) | (1U << 8), 0)) ||
+		    (error = airgpio_update(sc->sc_chip, AIRGPIO_PON,
+		    1U << 13, 0)) ||
+		    (error = airgpio_update(sc->sc_gpio, 0x34, 6, 0)) ||
+		    (error = airgpio_update(sc->sc_chip, AIRGPIO_FORCE, 6, 6)))
+			return error;
+		return 0;
+	}
+	len = OF_getproplen(node, "pins");
+	if (len <= 0 || len > sizeof(pins) ||
+	    OF_getprop(node, "pins", pins, sizeof(pins)) != len ||
+	    pins[len - 1] != '\0')
+		return EINVAL;
+	high = OF_getproplen(node, "output-high") == 0;
+	low = OF_getproplen(node, "output-low") == 0;
+	input = OF_getproplen(node, "input-enable") == 0;
+	output = high || low;
+	if (high + low + input != 1)
+		return EOPNOTSUPP;
+	for (pos = 0; pos < len; pos += strlen(pins + pos) + 1) {
+		pin = airgpio_pin(pins + pos);
+		if (pin < 0)
+			return EINVAL;
+		if (!apply)
+			continue;
+		/* Preload the latch before enabling output to avoid a glitch. */
+		if (output && (error = airgpio_set(sc, pin, high)) != 0)
+			return error;
+		if ((error = airgpio_config(sc, pin,
+		    output ? GPIO_CONFIG_OUTPUT : GPIO_CONFIG_INPUT)) != 0)
+			return error;
+	}
+	return 0;
+}
+
+int
+airgpio_pinctrl(uint32_t phandle, void *cookie)
+{
+	struct airgpio_softc *sc = cookie;
+	int node = OF_getnodebyphandle(phandle), error;
+
+	if (node == 0 || OF_parent(node) != sc->sc_node)
+		return EINVAL;
+	mtx_enter(&sc->sc_lock);
+	error = airgpio_state(sc, node, 0);
+	if (!error)
+		error = airgpio_state(sc, node, 1);
+	mtx_leave(&sc->sc_lock);
+	return error;
+}
+
+void
+airgpio_wait(struct airgpio_softc *sc, unsigned int usec)
+{
+	if (usec >= 1000)
+		tsleep_nsec(sc, PWAIT, "airgprst", (uint64_t)usec * 1000);
+	else
+		delay(usec);
+}
+
+/* Called at mountroot, before any PHY MDIO transaction or firmware upload. */
+int
+airgpio_phy_reset(int phynode)
+{
+	struct airgpio_softc *sc = NULL, *candidate;
+	uint32_t gpio[3], states[16], assert_us, deassert_us;
+	int busnode, provider, len, index, i, error, asserted;
+
+	if (OF_getproplen(phynode, "reset-gpios") != sizeof(gpio) ||
+	    OF_getpropintarray(phynode, "reset-gpios", gpio,
+	    sizeof(gpio)) != sizeof(gpio) || gpio[1] >= AIRGPIO_NPINS ||
+	    (gpio[2] & ~GPIO_ACTIVE_LOW))
+		return EINVAL;
+	provider = OF_getnodebyphandle(gpio[0]);
+	for (i = 0; i < airgpio_cd.cd_ndevs; i++) {
+		candidate = airgpio_cd.cd_devs[i];
+		if (candidate && candidate->sc_node != 0 &&
+		    candidate->sc_node == provider)
+			sc = candidate;
+	}
+	if (sc == NULL)
+		return ENODEV;
+	assert_us = OF_getpropint(phynode, "reset-assert-us", 10000);
+	deassert_us = OF_getpropint(phynode, "reset-deassert-us", 20000);
+	if (assert_us > 1000000 || deassert_us > 1000000)
+		return EINVAL;
+	/* The MDIO controller is a child of the switch owning pinctrl-0. */
+	busnode = OF_parent(OF_parent(phynode));
+	index = OF_getindex(busnode, "default", "pinctrl-names");
+	if (index != 0)
+		return ENODEV;
+	len = OF_getproplen(busnode, "pinctrl-0");
+	if (len <= 0 || len > sizeof(states) || (len % 4) != 0 ||
+	    OF_getpropintarray(busnode, "pinctrl-0", states,
+	    sizeof(states)) != len)
+		return EINVAL;
+	/* Call each state directly: pinctrl_byid() discards callback errors. */
+	for (i = 0; i < len / sizeof(states[0]); i++)
+		if (pinctrl_byphandle(states[i]) != 0)
+			return EIO;
+	asserted = !(gpio[2] & GPIO_ACTIVE_LOW);
+	mtx_enter(&sc->sc_lock);
+	error = airgpio_set(sc, gpio[1], asserted);
+	if (!error)
+		error = airgpio_config(sc, gpio[1], GPIO_CONFIG_OUTPUT);
+	if (!error && airgpio_get(sc, gpio[1]) != asserted)
+		error = EIO;
+	mtx_leave(&sc->sc_lock);
+	if (error)
+		return error;
+	airgpio_wait(sc, assert_us);
+	mtx_enter(&sc->sc_lock);
+	error = airgpio_set(sc, gpio[1], !asserted);
+	if (!error && airgpio_get(sc, gpio[1]) != !asserted)
+		error = EIO;
+	mtx_leave(&sc->sc_lock);
+	if (!error)
+		airgpio_wait(sc, deassert_us);
+	return error;
+}
