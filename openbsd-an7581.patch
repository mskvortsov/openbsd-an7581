+/* EN8811H firmware and PHY management over a Clause 22 MDIO transport. */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+
+#include <dev/mii/mii.h>
+#include <dev/fdt/airmdio.h>
+#include <dev/fdt/en8811var.h>
+
+#define EN8811_ID		0x03a2a410U
+#define EN8811_PAGE		0x1f
+#define EN8811_AUX		0x1d
+#define EN8811_PBUS_MODE		0x10
+#define EN8811_PBUS_WAH		0x11
+#define EN8811_PBUS_WAL		0x12
+#define EN8811_PBUS_WDH		0x13
+#define EN8811_PBUS_WDL		0x14
+#define EN8811_PBUS_RAH		0x15
+#define EN8811_PBUS_RAL		0x16
+#define EN8811_PBUS_RDH		0x17
+#define EN8811_PBUS_RDL		0x18
+#define EN8811_PBUS_INCR		0x8000
+#define EN8811_PBUS_PAGE		4
+#define EN8811_FW_VERSION		0x003b3c
+#define EN8811_POLARITY		0x0ca0f8
+#define EN8811_GPIO_OUTPUT	0x0cf8b8
+#define EN8811_FW_CTRL		0x0f0018
+#define EN8811_FW_LOADING		0x800000
+#define EN8811_FW_LOAD_EN		(1U << 11)
+#define EN8811_FW_DM_ADDR		0
+#define EN8811_FW_DSP_ADDR		0x100000
+#define EN8811_FW_DM_MAX		0x4000
+#define EN8811_FW_DSP_MAX		0x20000
+#define EN8811_FW_CHUNK		64
+#define EN8811_MMD_VEND1		30
+#define EN8811_MMD_VEND2		31
+#define EN8811_MMD_AN		7
+#define EN8811_FW_STATUS		0x8009
+#define EN8811_FW_READY		2
+#define EN8811_CMD(n)		(0x800c + (n))
+#define EN8811_LED_CTRL		0x21
+#define EN8811_LED_ON(n)		(0x24 + 2 * (n))
+#define EN8811_LED_BLINK(n)	(0x25 + 2 * (n))
+#define EN8811_AN_2500_CTRL	0x20
+#define EN8811_AN_ADV_2500	0x80
+
+#define PHY_READ(ep, reg)		\
+	((ep)->ep_mdio->am_read((ep)->ep_mdio->am_cookie, (ep)->ep_addr, (reg)))
+#define PHY_WRITE(ep, reg, val)	\
+	((ep)->ep_mdio->am_write((ep)->ep_mdio->am_cookie, (ep)->ep_addr, \
+	    (reg), (val)))
+
+int	en8811_page_enter(struct en8811_phy *, int, int *);
+int	en8811_page_leave(struct en8811_phy *, int, int);
+int	en8811_mmd_read(struct en8811_phy *, int, int);
+int	en8811_mmd_write(struct en8811_phy *, int, int, int);
+int	en8811_pbus(struct en8811_phy *, uint32_t, uint32_t *, uint32_t, int);
+int	en8811_write_firmware(struct en8811_phy *, uint32_t,
+	    const uint8_t *, size_t);
+int	en8811_wait_ready(struct en8811_phy *);
+int	en8811_config(struct en8811_phy *);
+
+/* Successful entry leaves the transport locked, until page_leave(). */
+int
+en8811_page_enter(struct en8811_phy *ep, int page, int *saved)
+{
+	mtx_enter(&ep->ep_mdio->am_lock);
+	*saved = PHY_READ(ep, EN8811_PAGE);
+	if (*saved < 0) {
+		mtx_leave(&ep->ep_mdio->am_lock);
+		return EIO;
+	}
+	if (PHY_WRITE(ep, EN8811_PAGE, page)) {
+		PHY_WRITE(ep, EN8811_PAGE, *saved);
+		mtx_leave(&ep->ep_mdio->am_lock);
+		return EIO;
+	}
+	return 0;
+}
+
+int
+en8811_page_leave(struct en8811_phy *ep, int saved, int error)
+{
+	int restore;
+
+	restore = PHY_WRITE(ep, EN8811_PAGE, saved);
+	/* A timed-out transaction may recover; still report the first error. */
+	if (restore)
+		PHY_WRITE(ep, EN8811_PAGE, saved);
+	mtx_leave(&ep->ep_mdio->am_lock);
+	return error ? error : restore;
+}
+
+/* Clause 45 via registers 13/14: the entire address/data cycle is atomic. */
+int
+en8811_mmd_read(struct en8811_phy *ep, int dev, int reg)
+{
+	int saved, error, val = -1;
+
+	if ((error = en8811_page_enter(ep, 0, &saved)) != 0)
+		return -1;
+	if (PHY_WRITE(ep, MII_MMDACR, dev) ||
+	    PHY_WRITE(ep, MII_MMDAADR, reg) ||
+	    PHY_WRITE(ep, MII_MMDACR, dev | MMDACR_FN_DATANPI))
+		error = EIO;
+	else if ((val = PHY_READ(ep, MII_MMDAADR)) < 0)
+		error = EIO;
+	if (en8811_page_leave(ep, saved, error))
+		return -1;
+	return val;
+}
+
+int
+en8811_mmd_write(struct en8811_phy *ep, int dev, int reg, int val)
+{
+	int saved, error;
+
+	if ((error = en8811_page_enter(ep, 0, &saved)) != 0)
+		return error;
+	if (PHY_WRITE(ep, MII_MMDACR, dev) ||
+	    PHY_WRITE(ep, MII_MMDAADR, reg) ||
+	    PHY_WRITE(ep, MII_MMDACR, dev | MMDACR_FN_DATANPI) ||
+	    PHY_WRITE(ep, MII_MMDAADR, val))
+		error = EIO;
+	return en8811_page_leave(ep, saved, error);
+}
+
+/* op: 0 = read, 1 = write, 2 = replace the bits selected by mask. */
+int
+en8811_pbus(struct en8811_phy *ep, uint32_t addr, uint32_t *data,
+    uint32_t mask, int op)
+{
+	uint32_t val = *data;
+	int saved, error, hi, lo;
+
+	if ((error = en8811_page_enter(ep, EN8811_PBUS_PAGE, &saved)) != 0)
+		return error;
+	if (PHY_WRITE(ep, EN8811_PBUS_MODE, 0)) {
+		error = EIO;
+		goto out;
+	}
+	if (op != 1) {
+		if (PHY_WRITE(ep, EN8811_PBUS_RAH, addr >> 16) ||
+		    PHY_WRITE(ep, EN8811_PBUS_RAL, addr & 0xffff)) {
+			error = EIO;
+			goto out;
+		}
+		hi = PHY_READ(ep, EN8811_PBUS_RDH);
+		lo = PHY_READ(ep, EN8811_PBUS_RDL);
+		if (hi < 0 || lo < 0) {
+			error = EIO;
+			goto out;
+		}
+		val = ((uint32_t)hi << 16) | lo;
+		if (op == 0) {
+			*data = val;
+			goto out;
+		}
+		val = (val & ~mask) | (*data & mask);
+	}
+	if (PHY_WRITE(ep, EN8811_PBUS_WAH, addr >> 16) ||
+	    PHY_WRITE(ep, EN8811_PBUS_WAL, addr & 0xffff) ||
+	    PHY_WRITE(ep, EN8811_PBUS_WDH, val >> 16) ||
+	    PHY_WRITE(ep, EN8811_PBUS_WDL, val & 0xffff))
+		error = EIO;
+out:
+	return en8811_page_leave(ep, saved, error);
+}
+
+/*
+ * Bound each transaction so link polling can use the bus between chunks.
+ * Firmware words are little endian, but MDIO sends the high half first.
+ */
+int
+en8811_write_firmware(struct en8811_phy *ep, uint32_t addr,
+    const uint8_t *fw, size_t len)
+{
+	size_t off, n, i;
+	int saved, error;
+	uint32_t word;
+
+	for (off = 0; off < len; off += n) {
+		n = MIN(len - off, EN8811_FW_CHUNK);
+		if ((error = en8811_page_enter(ep, EN8811_PBUS_PAGE, &saved)))
+			return error;
+		if (PHY_WRITE(ep, EN8811_PBUS_MODE, EN8811_PBUS_INCR) ||
+		    PHY_WRITE(ep, EN8811_PBUS_WAH, (addr + off) >> 16) ||
+		    PHY_WRITE(ep, EN8811_PBUS_WAL, (addr + off) & 0xffff)) {
+			error = EIO;
+			goto out;
+		}
+		for (i = off; i < off + n; i += 4) {
+			word = fw[i] | ((uint32_t)fw[i + 1] << 8) |
+			    ((uint32_t)fw[i + 2] << 16) | ((uint32_t)fw[i + 3] << 24);
+			if (PHY_WRITE(ep, EN8811_PBUS_WDH, word >> 16) ||
+			    PHY_WRITE(ep, EN8811_PBUS_WDL, word & 0xffff)) {
+				error = EIO;
+				break;
+			}
+		}
+out:
+		error = en8811_page_leave(ep, saved, error);
+		if (error)
+			return error;
+	}
+	return 0;
+}
+
+int
+en8811_wait_ready(struct en8811_phy *ep)
+{
+	int i, val;
+
+	for (i = 0; i < 375; i++) {
+		val = en8811_mmd_read(ep, EN8811_MMD_VEND1, EN8811_FW_STATUS);
+		if (val < 0)
+			return EIO;
+		if (val == EN8811_FW_READY)
+			return 0;
+		/* No MDIO lock or raised IPL across the MCU startup wait. */
+		tsleep_nsec(ep, PWAIT, "airmcu", MSEC_TO_NSEC(20));
+	}
+	return ETIMEDOUT;
+}
+
+int
+en8811_config(struct en8811_phy *ep)
+{
+	static const uint16_t mode1[] = { 0, 0, 0x1101, 2 };
+	static const uint16_t led_on[] = { 0xc107, 0xc101, 0xc102 };
+	uint32_t val;
+	unsigned int i;
+	int error;
+
+	/* Fixed 2500BASE-X host link with copper-side rate adaptation. */
+	for (i = 0; i < nitems(mode1); i++)
+		if ((error = en8811_mmd_write(ep, EN8811_MMD_VEND1,
+		    EN8811_CMD(i), mode1[i])) != 0)
+			return error;
+	val = (ep->ep_rxswap ? 2 : 0) | (ep->ep_txswap ? 0 : 1);
+	if ((error = en8811_pbus(ep, EN8811_POLARITY, &val, 3, 2)))
+		return error;
+
+	/* Native LED defaults: activity, 1/2.5Gb/s, and 100Mb/s/2.5Gb/s. */
+	if (en8811_mmd_write(ep, EN8811_MMD_VEND2, 0x23, 2048) ||
+	    en8811_mmd_write(ep, EN8811_MMD_VEND2, 0x22, 1024) ||
+	    en8811_mmd_write(ep, EN8811_MMD_VEND2, EN8811_LED_CTRL, 0x8008))
+		return EIO;
+	for (i = 0; i < nitems(led_on); i++)
+		if (en8811_mmd_write(ep, EN8811_MMD_VEND2,
+		    EN8811_LED_ON(i), led_on[i]) ||
+		    en8811_mmd_write(ep, EN8811_MMD_VEND2,
+		    EN8811_LED_BLINK(i), i == 0 ? 0x33f : 0))
+			return EIO;
+	val = (1U << 3) | (1U << 4) | (1U << 5);
+	return en8811_pbus(ep, EN8811_GPIO_OUTPUT, &val, val, 2);
+}
+
+int
+en8811_aneg(struct en8811_phy *ep)
+{
+	int saved, error, val;
+
+	if (!ep->ep_ready)
+		return ENXIO;
+	val = en8811_mmd_read(ep, EN8811_MMD_AN, EN8811_AN_2500_CTRL);
+	if (val < 0 || en8811_mmd_write(ep, EN8811_MMD_AN,
+	    EN8811_AN_2500_CTRL, val | EN8811_AN_ADV_2500))
+		return EIO;
+	if ((error = en8811_page_enter(ep, 0, &saved)) != 0)
+		return error;
+	/* Only full duplex 100/1000/2500 is supported by this PHY. */
+	if (PHY_WRITE(ep, MII_ANAR,
+	    ANAR_CSMA | ANAR_TX_FD | ANAR_PAUSE_TOWARDS)) {
+		error = EIO;
+		goto out;
+	}
+	val = PHY_READ(ep, MII_100T2CR);
+	if (val < 0 || PHY_WRITE(ep, MII_100T2CR,
+	    (val & ~GTCR_ADV_1000THDX) | GTCR_ADV_1000TFDX)) {
+		error = EIO;
+		goto out;
+	}
+	val = PHY_READ(ep, MII_BMCR);
+	if (val < 0 || PHY_WRITE(ep, MII_BMCR,
+	    (val & ~(BMCR_PDOWN | BMCR_ISO | BMCR_LOOP)) |
+	    BMCR_AUTOEN | BMCR_STARTNEG))
+		error = EIO;
+out:
+	return en8811_page_leave(ep, saved, error);
+}
+
+int
+en8811_init(struct en8811_phy *ep, const uint8_t *dm, size_t dmlen,
+    const uint8_t *dsp, size_t dsplen)
+{
+	uint32_t val;
+	int saved, error, id1, id2;
+
+	ep->ep_ready = 0;
+	ep->ep_version = 0;
+	/* Reject malformed images before touching the MCU or reading past EOF. */
+	if (ep->ep_mdio == NULL || ep->ep_mdio->am_read == NULL ||
+	    ep->ep_mdio->am_write == NULL || ep->ep_addr < 0 || ep->ep_addr > 31 ||
+	    dm == NULL || dsp == NULL || dmlen == 0 || dsplen == 0 ||
+	    dmlen > EN8811_FW_DM_MAX || dsplen > EN8811_FW_DSP_MAX ||
+	    (dmlen & 3) || (dsplen & 3))
+		return EINVAL;
+	if ((error = en8811_page_enter(ep, 0, &saved)) != 0)
+		return error;
+	id1 = PHY_READ(ep, MII_PHYIDR1);
+	id2 = PHY_READ(ep, MII_PHYIDR2);
+	error = (id1 < 0 || id2 < 0) ? EIO : 0;
+	if ((error = en8811_page_leave(ep, saved, error)) != 0)
+		return error;
+	if ((((uint32_t)id1 << 16) | (id2 & 0xfff0)) != EN8811_ID)
+		return ENODEV;
+
+	val = 0;
+	if ((error = en8811_pbus(ep, EN8811_FW_CTRL, &val, 0, 1)))
+		return error;
+	val = EN8811_FW_LOAD_EN;
+	if ((error = en8811_pbus(ep, EN8811_FW_LOADING, &val, val, 2)))
+		goto fail;
+	if ((error = en8811_write_firmware(ep, EN8811_FW_DM_ADDR, dm, dmlen)))
+		goto fail;
+	if ((error = en8811_write_firmware(ep, EN8811_FW_DSP_ADDR, dsp, dsplen)))
+		goto fail;
+	val = 0;
+	if ((error = en8811_pbus(ep, EN8811_FW_LOADING, &val,
+	    EN8811_FW_LOAD_EN, 2)))
+		goto fail;
+	val = 1;
+	if ((error = en8811_pbus(ep, EN8811_FW_CTRL, &val, 0, 1)))
+		goto fail;
+	if ((error = en8811_wait_ready(ep)) != 0)
+		goto fail;
+	val = 0;
+	if ((error = en8811_pbus(ep, EN8811_FW_VERSION, &val, 0, 0)))
+		goto fail;
+	ep->ep_version = val;
+	if ((error = en8811_config(ep)) != 0)
+		goto fail;
+	ep->ep_ready = 1;
+	if ((error = en8811_aneg(ep)) == 0)
+		return 0;
+fail:
+	/* A partial image must never be run as if firmware loading succeeded. */
+	ep->ep_ready = 0;
+	val = 0;
+	en8811_pbus(ep, EN8811_FW_CTRL, &val, 0, 1);
+	return error;
+}
+
+int
+en8811_status(struct en8811_phy *ep, int *speed)
+{
+	int saved, error, bmsr, aux;
+
+	*speed = 0;
+	if (!ep->ep_ready)
+		return ENXIO;
+	if ((error = en8811_page_enter(ep, 0, &saved)) != 0)
+		return error;
+	/* BMSR link status is latched low.  Both reads must succeed. */
+	bmsr = PHY_READ(ep, MII_BMSR);
+	if (bmsr < 0 || (bmsr = PHY_READ(ep, MII_BMSR)) < 0) {
+		error = EIO;
+		goto out;
+	}
+	if ((bmsr & (BMSR_LINK | BMSR_ACOMP)) != (BMSR_LINK | BMSR_ACOMP))
+		goto out;
+	aux = PHY_READ(ep, EN8811_AUX);
+	if (aux < 0) {
+		error = EIO;
+		goto out;
+	}
+	switch (aux & 0x1c) {
+	case 4:
+		*speed = 100;
+		break;
+	case 8:
+		*speed = 1000;
+		break;
+	case 12:
+		*speed = 2500;
+		break;
+	default:
+		error = EIO;
+	}
+out:
+	error = en8811_page_leave(ep, saved, error);
+	if (error)
+		*speed = 0;
+	return error;
+}
