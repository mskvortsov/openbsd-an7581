+int
+aireth_match(struct device *parent, void *cfdata, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	return OF_is_compatible(faa->fa_node, "airoha,en7581-eth");
+}
+
+void
+aireth_attach(struct device *parent, struct device *self, void *aux)
+{
+	struct aireth_softc *sc = (void *)self;
+	struct fdt_attach_args *faa = aux;
+	int fe, qdma, qdma1, node, i;
+
+	fe = OF_getindex(faa->fa_node, "fe", "reg-names");
+	qdma = OF_getindex(faa->fa_node, "qdma0", "reg-names");
+	if (fe < 0 || fe >= faa->fa_nreg ||
+	    qdma < 0 || qdma >= faa->fa_nreg) {
+		printf(": no registers\n");
+		return;
+	}
+
+	sc->sc_node = faa->fa_node;
+	sc->sc_iot = faa->fa_iot;
+	/* GDM4's source-port register lies beyond the DT's 0x2600 size. */
+	sc->sc_fe_iosize = MAX(faa->fa_reg[fe].size,
+	    FE_GDM_SRC_PORT_SET(4) + sizeof(uint32_t));
+	if (bus_space_map(sc->sc_iot, faa->fa_reg[fe].addr,
+	    sc->sc_fe_iosize, 0, &sc->sc_fe_ioh)) {
+		printf(": can't map FE registers\n");
+		return;
+	}
+	if (bus_space_map(sc->sc_iot, faa->fa_reg[qdma].addr,
+	    faa->fa_reg[qdma].size, 0, &sc->sc_qdma_ioh)) {
+		printf(": can't map QDMA registers\n");
+		goto unmap_fe;
+	}
+	sc->sc_dmat = faa->fa_dmat;
+
+	sc->sc_txq[0].q_sc = sc;
+	sc->sc_txq[0].q_id = 0;
+	sc->sc_txq[0].q_ioh = sc->sc_qdma_ioh;
+	sc->sc_ntxq = 1;
+
+	/*
+	 * Before anything else: Linux may have left both QDMAs running,
+	 * not even a kexec stops them.
+	 */
+	qdma1 = OF_getindex(faa->fa_node, "qdma1", "reg-names");
+	if (qdma1 >= 0 && qdma1 < faa->fa_nreg &&
+	    bus_space_map(sc->sc_iot, faa->fa_reg[qdma1].addr,
+	    faa->fa_reg[qdma1].size, 0, &sc->sc_txq[1].q_ioh) == 0) {
+		sc->sc_txq[1].q_sc = sc;
+		sc->sc_txq[1].q_id = 1;
+	} else
+		qdma1 = -1;
+	i = aireth_stop_qdma(sc, sc->sc_qdma_ioh);
+	if (qdma1 != -1 && aireth_stop_qdma(sc, sc->sc_txq[1].q_ioh))
+		i = ETIMEDOUT;
+	if (i) {
+		printf(": DMA stop timeout\n");
+		goto unmap_qdma;
+	}
+
+	/* GDM1 is connected to the switch; GDM4 is lan1 (WAN). */
+	for (node = OF_child(faa->fa_node); node; node = OF_peer(node)) {
+		if (OF_is_compatible(node, "airoha,eth-mac") &&
+		    OF_getpropint(node, "reg", 0) == 1 && OF_is_enabled(node))
+			break;
+	}
+	if (node == 0) {
+		printf(": GDM1 not enabled\n");
+		goto unmap_qdma;
+	}
+	if (aireth_port_attach(sc, &sc->sc_ports[0], node, 1))
+		goto unmap_qdma;
+	printf(": address %s", ether_sprintf(sc->sc_ports[0].ap_ac.ac_enaddr));
+
+	for (node = OF_child(faa->fa_node); node; node = OF_peer(node)) {
+		if (OF_is_compatible(node, "airoha,eth-mac") &&
+		    OF_getpropint(node, "reg", 0) == 4 && OF_is_enabled(node))
+			break;
+	}
+	if (node && qdma1 != -1 &&
+	    aireth_port_attach(sc, &sc->sc_ports[1], node, 4) == 0)
+		printf(", %s address %s", sc->sc_ports[1].ap_ac.ac_if.if_xname,
+		    ether_sprintf(sc->sc_ports[1].ap_ac.ac_enaddr));
+	printf("\n");
+
+	if (sc->sc_nports > 1)
+		sc->sc_ntxq = 2;
+	for (i = 0; i < sc->sc_ntxq; i++)
+		mtx_init(&sc->sc_txq[i].q_mtx, IPL_NET);
+	for (i = 0; i < sc->sc_nports; i++)
+		sc->sc_ports[i].ap_txq =
+		    &sc->sc_txq[sc->sc_ports[i].ap_gdm == 1 ? 0 : 1];
+	timeout_set(&sc->sc_rxto, aireth_rxtick, sc);
+	mtx_init(&sc->sc_rx_mtx, IPL_NET);
+
+	if (aireth_hw_init(sc))
+		goto unmap_qdma;
+
+	/* The first interrupt serves QDMA0 TX and RX ring 0. */
+	sc->sc_ih = fdt_intr_establish_idx(faa->fa_node, 0,
+	    IPL_NET | IPL_MPSAFE, aireth_intr, sc, DEVNAME(sc));
+	if (sc->sc_ih == NULL) {
+		printf("%s: can't establish interrupt\n", DEVNAME(sc));
+		goto free_hw;
+	}
+	sc->sc_txq[0].q_ih = sc->sc_ih;
+	/* QDMA1 bank 0 (index 4) carries its Tx completions. */
+	if (sc->sc_ntxq > 1) {
+		sc->sc_txq[1].q_ih = fdt_intr_establish_idx(faa->fa_node, 4,
+		    IPL_NET | IPL_MPSAFE, aireth_intr_txq, &sc->sc_txq[1],
+		    DEVNAME(sc));
+		if (sc->sc_txq[1].q_ih == NULL) {
+			printf("%s: can't establish QDMA1 interrupt\n",
+			    DEVNAME(sc));
+			fdt_intr_disestablish(sc->sc_ih);
+			sc->sc_ih = sc->sc_txq[0].q_ih = NULL;
+			goto free_hw;
+		}
+	}
+	config_defer(self, aireth_deferred);
+	if (sc->sc_nports > 1)
+		config_mountroot(self, aireth_attachhook);
+	return;
+
+free_hw:
+	aireth_hw_free(sc);
+unmap_qdma:
+	if (qdma1 != -1)
+		bus_space_unmap(sc->sc_iot, sc->sc_txq[1].q_ioh,
+		    faa->fa_reg[qdma1].size);
+	bus_space_unmap(sc->sc_iot, sc->sc_qdma_ioh, faa->fa_reg[qdma].size);
+unmap_fe:
+	bus_space_unmap(sc->sc_iot, sc->sc_fe_ioh, sc->sc_fe_iosize);
+}
+
+/* Attach LAN only after its sibling switch has finished native setup. */
+void
+aireth_deferred(struct device *self)
+{
+	struct aireth_softc *sc = (struct aireth_softc *)self;
+	struct aireth_port *ap;
+	struct ifnet *ifp;
+	int i, ready;
+
+	for (i = 0; i < sc->sc_nports; i++) {
+		ap = &sc->sc_ports[i];
+		if (ap->ap_phy != -1)
+			continue;
+		ifp = &ap->ap_ac.ac_if;
+		ready = 0;
+#if NAIRSW > 0
+		ready = airsw_lan_ready(ap->ap_node);
+#endif
+		if (!ready) {
+			printf("%s: native LAN switch unavailable\n", ifp->if_xname);
+			continue;
+		}
+		/* Retry NVMEM after other devices on this bus have attached. */
+		aireth_enaddr(ap->ap_node, ap->ap_ac.ac_enaddr);
+		ifp->if_baudrate = IF_Mbps(10000);
+		if_attach(ifp);
+		ether_ifattach(ifp);
+	}
+}
+
+/* Prefer a valid DT address, then an available unmodified NVMEM MAC cell. */
+int
+aireth_enaddr(int node, uint8_t *address)
+{
+	static char * const properties[] = { "local-mac-address", "mac-address" };
+	static const uint8_t zero[ETHER_ADDR_LEN];
+	uint8_t value[ETHER_ADDR_LEN];
+	uint32_t cell[2], reg[2];
+	int i, len, cellnode;
+
+	for (i = 0; i < nitems(properties); i++) {
+		if (OF_getproplen(node, properties[i]) != sizeof(value) ||
+		    OF_getprop(node, properties[i], value, sizeof(value)) != sizeof(value))
+			continue;
+		if (!(value[0] & 1) && memcmp(value, zero, sizeof(value)) != 0) {
+			memcpy(address, value, sizeof(value));
+			return 0;
+		}
+	}
+	/* The generic API accepts raw cells, not MAC address increments. */
+	len = OF_getproplen(node, "nvmem-cells");
+	if (OF_getindex(node, "mac-address", "nvmem-cell-names") != 0 ||
+	    (len != sizeof(cell[0]) && len != sizeof(cell)) ||
+	    OF_getpropintarray(node, "nvmem-cells", cell, sizeof(cell)) != len ||
+	    (len == sizeof(cell) && cell[1] != 0))
+		return ENOENT;
+	cellnode = OF_getnodebyphandle(cell[0]);
+	if (!cellnode || OF_getproplen(cellnode, "reg") != sizeof(reg) ||
+	    OF_getpropintarray(cellnode, "reg", reg, sizeof(reg)) != sizeof(reg) ||
+	    reg[1] != sizeof(value) || OF_getproplen(cellnode, "bits") >= 0)
+		return ENOENT;
+	memset(value, 0, sizeof(value));
+	if (nvmem_read_cell(node, "mac-address", value, sizeof(value)) == 0 &&
+	    !(value[0] & 1) && memcmp(value, zero, sizeof(value)) != 0) {
+		memcpy(address, value, sizeof(value));
+		return 0;
+	}
+	return ENOENT;
+}
+
+void
+aireth_attachhook(struct device *self)
+{
+	struct aireth_softc *sc = (struct aireth_softc *)self;
+	struct aireth_port *ap;
+	struct en8811_phy *ep;
+	struct ifnet *ifp;
+	uint8_t *dm, *dsp;
+	size_t dmlen, dsplen;
+	int i, error;
+
+	for (i = 0; i < sc->sc_nports; i++) {
+		ap = &sc->sc_ports[i];
+		if (ap->ap_phy == -1)
+			continue;
+		ifp = &ap->ap_ac.ac_if;
+		ep = &ap->ap_phydev;
+#if NAIRPCS > 0
+		ap->ap_pcs = airpcs_by_node(ap->ap_pcsnode);
+#endif
+		if (ap->ap_pcs == NULL) {
+			printf("%s: Ethernet PCS unavailable\n", ifp->if_xname);
+			continue;
+		}
+#if NAIRSW > 0
+		ep->ep_mdio = airsw_mdio_by_node(OF_parent(ap->ap_phynode));
+#endif
+		if (ep->ep_mdio == NULL) {
+			printf("%s: PHY MDIO bus unavailable\n", ifp->if_xname);
+			continue;
+		}
+		ep->ep_addr = ap->ap_phy;
+		ep->ep_rxswap = OF_getproplen(ap->ap_phynode,
+		    "airoha,pnswap-rx") >= 0;
+		ep->ep_txswap = OF_getproplen(ap->ap_phynode,
+		    "airoha,pnswap-tx") >= 0;
+
+		/* Load both images before halting the MCU or changing the PHY. */
+		error = loadfirmware(EN8811_FW_DM, &dm, &dmlen);
+		if (error) {
+			printf("%s: can't load %s: %d\n", ifp->if_xname,
+			    EN8811_FW_DM, error);
+			continue;
+		}
+		error = loadfirmware(EN8811_FW_DSP, &dsp, &dsplen);
+		if (error) {
+			printf("%s: can't load %s: %d\n", ifp->if_xname,
+			    EN8811_FW_DSP, error);
+			free(dm, M_DEVBUF, dmlen);
+			continue;
+		}
+#if NAIRGPIO > 0
+		error = airgpio_phy_reset(ap->ap_phynode);
+#else
+		error = ENODEV;
+#endif
+		if (error) {
+			printf("%s: PHY pinctrl/reset failed: %d\n",
+			    ifp->if_xname, error);
+			free(dm, M_DEVBUF, dmlen);
+			free(dsp, M_DEVBUF, dsplen);
+			continue;
+		}
+		error = en8811_init(ep, dm, dmlen, dsp, dsplen);
+		free(dm, M_DEVBUF, dmlen);
+		free(dsp, M_DEVBUF, dsplen);
+		if (error) {
+			printf("%s: EN8811H initialization failed: %d\n",
+			    ifp->if_xname, error);
+			continue;
+		}
+#if NAIRPCS > 0
+		error = airpcs_init(ap->ap_pcs);
+		if (error) {
+			printf("%s: PCS initialization failed: %d\n",
+			    ifp->if_xname, error);
+			continue;
+		}
+#endif
+		printf("%s: EN8811H firmware 0x%08x, native 2500BASE-X PCS\n",
+		    ifp->if_xname, ep->ep_version);
+		aireth_enaddr(ap->ap_node, ap->ap_ac.ac_enaddr);
+		if_attach(ifp);
+		ether_ifattach(ifp);
+	}
+}
+
+int
+aireth_port_attach(struct aireth_softc *sc, struct aireth_port *ap, int node,
+    int gdm)
+{
+	struct ifnet *ifp = &ap->ap_ac.ac_if;
+	uint32_t phandle;
+	char mode[32];
+	int phynode;
+
+	ap->ap_sc = sc;
+	ap->ap_node = node;
+	ap->ap_gdm = gdm;
+	ap->ap_fport = gdm == 4 ? AIRETH_FE_PORT_GDM4 : AIRETH_FE_PORT_GDM1;
+	ap->ap_phy = -1;
+	if (gdm != 1) {
+		phandle = OF_getpropint(node, "phy-handle", 0);
+		phynode = OF_getnodebyphandle(phandle);
+		if (phynode == 0 || !OF_is_enabled(phynode))
+			return ENODEV;
+		ap->ap_phy = OF_getpropint(phynode, "reg", -1);
+		if (ap->ap_phy < 0 || ap->ap_phy > 31)
+			return EINVAL;
+		memset(mode, 0, sizeof(mode));
+		OF_getprop(node, "phy-mode", mode, sizeof(mode) - 1);
+		if (strcmp(mode, "2500base-x") != 0)
+			return EINVAL;
+		ap->ap_phynode = phynode;
+		phandle = OF_getpropint(node, "pcs-handle", 0);
+		ap->ap_pcsnode = OF_getnodebyphandle(phandle);
+		if (ap->ap_pcsnode == 0 || !OF_is_enabled(ap->ap_pcsnode))
+			return ENODEV;
+	}
+
+	if (aireth_enaddr(node, ap->ap_ac.ac_enaddr))
+		ether_fakeaddr(ifp);
+
+	ifp->if_softc = ap;
+	ifp->if_flags = IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST;
+	ifp->if_xflags = IFXF_MPSAFE;
+	ifp->if_ioctl = aireth_ioctl;
+	ifp->if_qstart = aireth_start;
+	ifp->if_watchdog = aireth_watchdog;
+	ifq_init_maxlen(&ifp->if_snd, AIRETH_NTXDESC - 1);
+	/* XXX one device, two interfaces: aireth<2u> and aireth<2u+1>. */
+	snprintf(ifp->if_xname, IFNAMSIZ, "%s%d", sc->sc_dev.dv_cfdata->
+	    cf_driver->cd_name, sc->sc_dev.dv_unit * AIRETH_NPORTS +
+	    (int)(ap - sc->sc_ports));
+	ifp->if_capabilities = IFCAP_VLAN_MTU;
+
+	ifmedia_init(&ap->ap_media, 0, aireth_media_change,
+	    aireth_media_status);
+	if (ap->ap_phy == -1) {
+		/* The link to the switch is internal and always up. */
+		ap->ap_active = IFM_ETHER | IFM_MANUAL;
+		ifmedia_add(&ap->ap_media, IFM_ETHER | IFM_MANUAL, 0, NULL);
+		ifmedia_set(&ap->ap_media, IFM_ETHER | IFM_MANUAL);
+	} else {
+		/* Native PHY management, fixed 2500BASE-X host interface. */
+		ap->ap_active = IFM_ETHER | IFM_NONE;
+		ifmedia_add(&ap->ap_media, IFM_ETHER | IFM_AUTO, 0, NULL);
+		ifmedia_set(&ap->ap_media, IFM_ETHER | IFM_AUTO);
+		timeout_set(&ap->ap_tick, aireth_port_tick, ap);
+	}
+
+	sc->sc_nports++;
+	return 0;
+}
+
+/* Poll copper and host PCS link state; lan1 has no link interrupt. */
+void
+aireth_port_tick(void *arg)
+{
+	struct aireth_port *ap = arg;
+	struct ifnet *ifp = &ap->ap_ac.ac_if;
+	int speed = 0, state;
+	uint64_t active = IFM_ETHER | IFM_NONE;
+
+	ifp->if_baudrate = 0;
+	if (en8811_status(&ap->ap_phydev, &speed) != 0)
+		speed = 0;
+#if NAIRPCS > 0
+	if (airpcs_poll(ap->ap_pcs, speed != 0) != 1)
+		speed = 0;
+#endif
+	switch (speed) {
+	case 2500:
+		active = IFM_ETHER | IFM_2500_T | IFM_FDX;
+		ifp->if_baudrate = IF_Mbps(2500);
+		break;
+	case 1000:
+		active = IFM_ETHER | IFM_1000_T | IFM_FDX;
+		ifp->if_baudrate = IF_Mbps(1000);
+		break;
+	case 100:
+		active = IFM_ETHER | IFM_100_TX | IFM_FDX;
+		ifp->if_baudrate = IF_Mbps(100);
+		break;
+	default:
+		break;
+	}
+	ap->ap_active = active;
+
+	state = speed ? LINK_STATE_FULL_DUPLEX : LINK_STATE_DOWN;
+	if (ifp->if_link_state != state) {
+		ifp->if_link_state = state;
+		if_link_state_change(ifp);
+	}
+
+	if (ifp->if_flags & IFF_RUNNING)
+		timeout_add_sec(&ap->ap_tick, 1);
+}
+
+/*
+ * Set up a CPU-only datapath after resetting FE.  In particular, WAN
+ * VIP traffic must not retain Linux's route to CDM2 and QDMA1 Rx.
+ * PCS/SerDes and the external PHY have separate resets and are left alone.
+ */
+int
+aireth_fe_init(struct aireth_softc *sc)
+{
+	static const uint8_t nqueues[] = { 6, 6, 32, 6, 4, 6, 8, 10, 4, 2, 2 };
+	uint32_t val, limit, reserved = 0, pages;
+	unsigned int p;
+	int q, i;
+
+	/* Set PSE page size and reset its core and the GDM3/4 arbiters. */
+	val = FE_READ(sc, FE_DMA_GLO_CFG);
+	val &= ~FE_DMA_GLO_L2_SPACE_MASK;
+	val |= FE_DMA_GLO_L2_SPACE(2) | FE_DMA_GLO_PAGE_128;
+	FE_WRITE(sc, FE_DMA_GLO_CFG, val);
+	FE_WRITE(sc, FE_RST_GLO_CFG, FE_RST_CORE |
+	    FE_RST_GDM3_MBI_ARB | FE_RST_GDM4_MBI_ARB);
+	delay(1000);
+
+	/* Drop ingress on every GDM until the corresponding interface is up. */
+	for (p = 1; p <= 4; p++) {
+		val = FE_GDM_FWD_CFG_PAD_EN | FE_GDM_FWD_CFG_DROP_CRC_ERR |
+		    FE_GDM_FWD_CFG_DROP;
+		if (p >= 3)
+			val |= FE_GDM_FWD_CFG_STRIP_CRC;
+		FE_WRITE(sc, FE_GDM_FWD_CFG(p), val);
+		FE_WRITE(sc, FE_GDM_LEN_CFG(p),
+		    FE_GDM_LEN_SHORT(60) | FE_GDM_LEN_LONG(1536));
+		FE_WRITE(sc, FE_GDM_INGRESS_CFG(p), FE_GDM_INGRESS_FC_EN |
+		    (p >= 3 ? FE_GDM_INGRESS_STAG_EN : 0));
+		FE_WRITE(sc, FE_GDM_LPBK_CFG(p), 0);
+	}
+	val = FE_READ(sc, FE_GDM_SRC_PORT_SET(4));
+	val &= ~FE_GDM_SPORT_OFFSET_MASK;
+	FE_WRITE(sc, FE_GDM_SRC_PORT_SET(4), val | FE_GDM_SPORT_OFFSET_8);
+
+	/* No packet classification, loopback, aggregation or offload engines. */
+	FE_WRITE(sc, FE_WAN_PORT, 0);
+	FE_WRITE(sc, FE_PCE_CFG, 0);
+	FE_WRITE(sc, FE_VIP_PORT_EN, 0);
+	FE_WRITE(sc, FE_IFC_PORT_EN, 0);
+	FE_WRITE(sc, FE_IFC_CFG, 0);
+	FE_WRITE(sc, FE_MC_VLAN_EN, 0);
+	for (i = 0; i < 2; i++)
+		FE_WRITE(sc, FE_PPE_GLO_CFG(i), 0);
+	for (i = 0; i < 32; i++)
+		FE_WRITE(sc, FE_VIP_EN(i), 0);
+	for (i = 0; i < 4; i++) {
+		/* All source ports default to CDM1; all Rx rings use OQ0. */
+		FE_WRITE(sc, FE_SP_DFT_CPORT(i), 0);
+		FE_WRITE(sc, FE_CDM1_OQ_MAP(i), 0);
+	}
+	for (p = 1; p <= 2; p++) {
+		FE_WRITE(sc, FE_CDM_VLAN_CTRL(p), (uint32_t)ETHERTYPE_VLAN << 16);
+		FE_WRITE(sc, FE_CDM_FWD_CFG(p), 0);
+		FE_WRITE(sc, FE_CDM_LRO_EN(p), 0);
+		for (i = 0; i < FE_CDM_NCRSN_QSEL; i++)
+			FE_WRITE(sc, FE_CDM_CRSN_QSEL(p, i), 0);
+	}
+	FE_WRITE(sc, FE_CPORT_CFG, FE_CPORT_PAD | FE_CPORT_PORT_XFC);
+
+	/* Input queue reservations, in 128-byte PSE pages. */
+	val = FE_READ(sc, FE_PSE_IQ_REV1);
+	FE_WRITE(sc, FE_PSE_IQ_REV1, (val & ~(0xffU << 16)) | (0x10U << 16));
+	val = FE_READ(sc, FE_PSE_IQ_REV2);
+	FE_WRITE(sc, FE_PSE_IQ_REV2, (val & ~0xffffU) | 0x4034);
+
+	/* Reserve space only for the CPU, switch and WAN output queues. */
+	for (p = 0; p < nitems(nqueues); p++) {
+		pages = (p == 0 || p == 1 || p == 5 || p == 9) ? 64 : 0;
+		for (q = 0; q < nqueues[p]; q++) {
+			FE_WRITE(sc, FE_PSE_QUEUE_VAL, pages);
+			FE_WRITE(sc, FE_PSE_QUEUE_CFG, FE_PSE_QUEUE_PORT(p) |
+			    FE_PSE_QUEUE_ID(q) | FE_PSE_QUEUE_WRITE |
+			    FE_PSE_QUEUE_OQRSV);
+			reserved += pages;
+		}
+	}
+	limit = FE_READ(sc, FE_PSE_FQ_CFG) & FE_PSE_FQ_LIMIT_MASK;
+	if (limit <= reserved + 0x100) {
+		printf("%s: invalid PSE free queue limit %u\n", DEVNAME(sc), limit);
+		return EIO;
+	}
+	val = limit - reserved - 0x100;
+	FE_WRITE(sc, FE_PSE_BUF_SET, ((3 * val / 4) << 16) | reserved);
+	FE_WRITE(sc, FE_PSE_SHARE_THD, (val << 16) |
+	    (limit - reserved - 0x20));
+	return 0;
+}
+
+/* Both DMA directions must be stopped before clearing ring registers. */
+void
+aireth_qdma_init(struct aireth_softc *sc, bus_space_handle_t ioh)
+{
+	uint32_t len;
+	int n, bank;
+
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_GLOBAL_CFG, 0);
+	for (n = 0; n < 5; n++) {
+		for (bank = 0; bank < 4; bank++)
+			bus_space_write_4(sc->sc_iot, ioh,
+			    QDMA_INT_ENABLE(bank, n), 0);
+		bus_space_write_4(sc->sc_iot, ioh,
+		    QDMA_INT_STATUS(n), 0xffffffff);
+	}
+	/* Drain both completion queues before replacing their backing storage. */
+	len = QDMA_IRQ_STATUS_ENTRY_LEN(bus_space_read_4(sc->sc_iot, ioh,
+	    QDMA_IRQ_STATUS));
+	while (len > 0) {
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_IRQ_CLEAR_LEN,
+		    MIN(len, 0x80));
+		len -= MIN(len, 0x80);
+	}
+	len = QDMA_IRQ_STATUS_ENTRY_LEN(bus_space_read_4(sc->sc_iot, ioh,
+	    QDMA_IRQ1_STATUS));
+	while (len > 0) {
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_IRQ1_CLEAR_LEN,
+		    MIN(len, 0x80));
+		len -= MIN(len, 0x80);
+	}
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_TX_IRQ_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_TX_IRQ_BASE, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_TX_IRQ1_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_TX_IRQ1_BASE, 0);
+
+	for (n = 0; n < QDMA_NTXRINGS; n++) {
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_TXN(n, QDMA_TX_CPU_IDX), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_TXN(n, QDMA_TX_DMA_IDX), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_TXN(n, QDMA_TX_RING_BASE), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_TXN(n, QDMA_TX_RING_BLOCKING), 0);
+	}
+	for (n = 0; n < QDMA_NRXRINGS; n++) {
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_CPU_IDX), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_DMA_IDX), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_RING_SIZE), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_RING_BASE), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_DELAY_INT), 0);
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_RXN(n, QDMA_RX_SCATTER_CFG), 0);
+	}
+	/* Only queue 0/channel 0 is used: strict priority and no rate limits. */
+	for (n = 0; n < 8; n++)
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_QUEUE_CLOSE(n), 0);
+	/* Mode 0 is WRR with eight weights; mode 1 is strict priority. */
+	for (n = 0; n < QDMA_NQOSREGS; n++)
+		bus_space_write_4(sc->sc_iot, ioh, QDMA_CHAN_QOS_MODE(n),
+		    QDMA_CHAN_QOS_MODE_SP);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_INGRESS_TRTCM_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_EGRESS_RATE_METER_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_EGRESS_TRTCM_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_GLB_TRTCM_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_TXQ_CNGST_CFG, 0);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_SLA_TRTCM_CFG, 0);
+}
+
+int
+aireth_hw_init(struct aireth_softc *sc)
+{
+	/* The XSI MAC and PHY resets belong to the PCS, not the FE. */
+	static const char *resets[] = {
+		"fe", "pdma", "qdma"
+	};
+	struct aireth_buf *rxb;
+	struct regmap *rm = NULL;
+	uint32_t cells[2];
+	int i, error;
+
+	/*
+	 * The FE and QDMA registers read as 0xdeadbeef unless the
+	 * shared FE memory is switched away from the CPU.  The SCU is
+	 * the provider of our resets; OF_getpropint() won't do here as
+	 * "resets" holds more than one cell.
+	 */
+	if (OF_getpropintarray(sc->sc_node, "resets", cells,
+	    sizeof(cells)) >= (int)sizeof(cells))
+		rm = regmap_byphandle(cells[0]);
+	if (rm == NULL) {
+		printf("%s: can't find SCU\n", DEVNAME(sc));
+		return ENODEV;
+	}
+	regmap_write_4(rm, SCU_SHARE_FEMEM_SEL, 0);
+
+	for (i = 0; i < nitems(resets); i++)
+		reset_assert(sc->sc_node, resets[i]);
+	delay(20000);
+	for (i = 0; i < nitems(resets); i++)
+		reset_deassert(sc->sc_node, resets[i]);
+	delay(20000);
+	if ((error = aireth_fe_init(sc)) != 0)
+		return error;
+	aireth_qdma_init(sc, sc->sc_qdma_ioh);
+	if (sc->sc_txq[1].q_sc != NULL)
+		aireth_qdma_init(sc, sc->sc_txq[1].q_ioh);
+
+	/* Allocate Rx descriptor ring. */
+	sc->sc_rxring = aireth_dmamem_alloc(sc,
+	    AIRETH_NRXDESC * sizeof(struct aireth_desc), 32);
+	if (sc->sc_rxring == NULL) {
+		printf("%s: can't allocate DMA memory\n", DEVNAME(sc));
+		return ENOMEM;
+	}
+	sc->sc_rxdesc = AIRETH_DMA_KVA(sc->sc_rxring);
+	sc->sc_rxbuf = mallocarray(AIRETH_NRXDESC, sizeof(struct aireth_buf),
+	    M_DEVBUF, M_WAITOK);
+	for (i = 0; i < AIRETH_NRXDESC; i++) {
+		rxb = &sc->sc_rxbuf[i];
+		bus_dmamap_create(sc->sc_dmat, MCLBYTES, 1,
+		    MCLBYTES, 0, BUS_DMA_WAITOK, &rxb->tb_map);
+		rxb->tb_m = NULL;
+	}
+
+	for (i = 0; i < sc->sc_ntxq; i++)
+		if ((error = aireth_txq_init(sc, &sc->sc_txq[i])) != 0)
+			return error;
+
+	QDMA_WRITE(sc, QDMA_RX_RING_BASE, AIRETH_DMA_DVA(sc->sc_rxring));
+	QDMA_WRITE(sc, QDMA_RX_RING_SIZE, QDMA_RX_RING_THR(32) |
+	    AIRETH_NRXDESC);
+	QDMA_WRITE(sc, QDMA_RX_DELAY_INT, 0);
+	QDMA_WRITE(sc, QDMA_RX_SCATTER_CFG, 1);
+
+	QDMA_WRITE(sc, QDMA_INT_ENABLE0, 0);
+	QDMA_WRITE(sc, QDMA_INT_ENABLE1, 0);
+	QDMA_WRITE(sc, QDMA_INT_STATUS0, 0xffffffff);
+	QDMA_WRITE(sc, QDMA_INT_STATUS1, 0xffffffff);
+
+	return 0;
+}
+
+/* Release initialized rings before any interface has been attached or started. */
+void
+aireth_hw_free(struct aireth_softc *sc)
+{
+	struct aireth_txq *q;
+	int i, j;
+
+	for (i = 0; i < sc->sc_ntxq; i++) {
+		q = &sc->sc_txq[i];
+		for (j = 0; j < AIRETH_NTXDESC; j++)
+			bus_dmamap_destroy(sc->sc_dmat, q->q_buf[j].tb_map);
+		free(q->q_buf, M_DEVBUF,
+		    AIRETH_NTXDESC * sizeof(struct aireth_buf));
+		aireth_dmamem_free(sc, q->q_ring);
+		aireth_dmamem_free(sc, q->q_irqring);
+		aireth_dmamem_free(sc, q->q_fwddesc);
+		aireth_dmamem_free(sc, q->q_fwdbuf);
+	}
+	for (i = 0; i < AIRETH_NRXDESC; i++)
+		bus_dmamap_destroy(sc->sc_dmat, sc->sc_rxbuf[i].tb_map);
+	free(sc->sc_rxbuf, M_DEVBUF,
+	    AIRETH_NRXDESC * sizeof(struct aireth_buf));
+	aireth_dmamem_free(sc, sc->sc_rxring);
+}
+
+int
+aireth_txq_init(struct aireth_softc *sc, struct aireth_txq *q)
+{
+	struct aireth_buf *txb;
+	uint32_t val;
+	int i, timo;
+
+	q->q_ring = aireth_dmamem_alloc(sc,
+	    AIRETH_NTXDESC * sizeof(struct aireth_desc), 32);
+	q->q_buf = mallocarray(AIRETH_NTXDESC, sizeof(struct aireth_buf),
+	    M_DEVBUF, M_WAITOK);
+	for (i = 0; i < AIRETH_NTXDESC; i++) {
+		txb = &q->q_buf[i];
+		bus_dmamap_create(sc->sc_dmat, MCLBYTES, AIRETH_NTXSEGS,
+		    MCLBYTES, 0, BUS_DMA_WAITOK, &txb->tb_map);
+		txb->tb_m = NULL;
+	}
+
+	/* Tx completion queue. */
+	q->q_irqring = aireth_dmamem_alloc(sc,
+	    AIRETH_NIRQ * sizeof(uint32_t), 32);
+
+	/* Buffers for the hardware forwarding link manager. */
+	q->q_fwddesc = aireth_dmamem_alloc(sc,
+	    AIRETH_NFWDDESC * sizeof(struct aireth_fwd_desc), 32);
+	q->q_fwdbuf = aireth_dmamem_alloc(sc,
+	    AIRETH_NFWDDESC * AIRETH_FWDBUFSZ, PAGE_SIZE);
+	if (q->q_ring == NULL || q->q_irqring == NULL ||
+	    q->q_fwddesc == NULL || q->q_fwdbuf == NULL) {
+		printf("%s: can't allocate QDMA%d memory\n", DEVNAME(sc),
+		    q->q_id);
+		return ENOMEM;
+	}
+	q->q_desc = AIRETH_DMA_KVA(q->q_ring);
+	q->q_irq = AIRETH_DMA_KVA(q->q_irqring);
+
+	TXQ_WRITE(q, QDMA_FWD_DSCP_BASE, AIRETH_DMA_DVA(q->q_fwddesc));
+	TXQ_WRITE(q, QDMA_FWD_BUF_BASE, AIRETH_DMA_DVA(q->q_fwdbuf));
+	val = TXQ_READ(q, QDMA_HW_FWD_DSCP_CFG);
+	val &= ~(QDMA_HW_FWD_DSCP_PAYLOAD_MASK |
+	    QDMA_HW_FWD_DSCP_MIN_SCAT_MASK);
+	val |= 1;	/* 2KB payload, minimum scatter length 1 */
+	TXQ_WRITE(q, QDMA_HW_FWD_DSCP_CFG, val);
+	TXQ_WRITE(q, QDMA_FWD_DSCP_LOW_THR, AIRETH_NFWDDESC / 2);
+	val = TXQ_READ(q, QDMA_LMGR_INIT_CFG);
+	val &= ~(QDMA_LMGR_INIT_START | QDMA_LMGR_SRAM_MODE |
+	    QDMA_LMGR_DESC_NUM_MASK);
+	val |= QDMA_LMGR_INIT_START | AIRETH_NFWDDESC;
+	TXQ_WRITE(q, QDMA_LMGR_INIT_CFG, val);
+	for (timo = 30; timo > 0; timo--) {
+		delay(1000);
+		if ((TXQ_READ(q, QDMA_LMGR_INIT_CFG) &
+		    QDMA_LMGR_INIT_START) == 0)
+			break;
+	}
+	if (timo == 0) {
+		printf("%s: QDMA%d link manager init timeout\n", DEVNAME(sc),
+		    q->q_id);
+		return ETIMEDOUT;
+	}
+
+	TXQ_WRITE(q, QDMA_TX_IRQ_BASE, AIRETH_DMA_DVA(q->q_irqring));
+	TXQ_WRITE(q, QDMA_TX_IRQ_CFG, QDMA_TX_IRQ_THR(1) |
+	    QDMA_TX_IRQ_DEPTH(AIRETH_NIRQ));
+	TXQ_WRITE(q, QDMA_TX_RING_BASE, AIRETH_DMA_DVA(q->q_ring));
+
+	if (q->q_id != 0) {
+		TXQ_WRITE(q, QDMA_INT_ENABLE0, 0);
+		TXQ_WRITE(q, QDMA_INT_ENABLE1, 0);
+		TXQ_WRITE(q, QDMA_INT_STATUS0, 0xffffffff);
+		TXQ_WRITE(q, QDMA_INT_STATUS1, 0xffffffff);
+	}
+	TXQ_WRITE(q, QDMA_GLOBAL_CFG, QDMA_GLOBAL_CFG_DMA_PREF(3) |
+	    QDMA_GLOBAL_CFG_CPU_TXR_RR | QDMA_GLOBAL_CFG_PAYLOAD_SWAP |
+	    QDMA_GLOBAL_CFG_IRQ0_EN | QDMA_GLOBAL_CFG_TX_WB_DONE |
+	    QDMA_GLOBAL_CFG_MAX_ISSUE(2));
+
+	return 0;
+}
+
+void
+aireth_txq_up(struct aireth_txq *q)
+{
+	struct aireth_softc *sc = q->q_sc;
+	int i;
+
+	/* Hardware sets the DONE bit when it is finished with a slot. */
+	for (i = 0; i < AIRETH_NTXDESC; i++) {
+		memset(&q->q_desc[i], 0, sizeof(struct aireth_desc));
+		q->q_desc[i].ctrl = htole32(AIRETH_CTRL_DONE);
+	}
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(q->q_ring),
+	    0, AIRETH_DMA_LEN(q->q_ring), BUS_DMASYNC_PREWRITE);
+
+	q->q_prod = q->q_cons = 0;
+	TXQ_WRITE(q, QDMA_TX_CPU_IDX, 0);
+	TXQ_WRITE(q, QDMA_TX_DMA_IDX, 0);
+
+	memset(q->q_irq, 0xff, AIRETH_NIRQ * sizeof(uint32_t));
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(q->q_irqring),
+	    0, AIRETH_DMA_LEN(q->q_irqring), BUS_DMASYNC_PREWRITE);
+
+	TXQ_WRITE(q, QDMA_INT_STATUS0, QDMA_INT0_IRQ0 | QDMA_INT0_IRQ0_FULL);
+	TXQ_WRITE(q, QDMA_INT_ENABLE0, QDMA_INT0_IRQ0 | QDMA_INT0_IRQ0_FULL);
+	TXQ_WRITE(q, QDMA_GLOBAL_CFG, TXQ_READ(q, QDMA_GLOBAL_CFG) |
+	    QDMA_GLOBAL_CFG_TX_DMA_EN);
+}
+
+void
+aireth_txq_down(struct aireth_txq *q)
+{
+	struct aireth_softc *sc = q->q_sc;
+	struct aireth_buf *txb;
+	int i, timo;
+
+	TXQ_WRITE(q, QDMA_GLOBAL_CFG, TXQ_READ(q, QDMA_GLOBAL_CFG) &
+	    ~QDMA_GLOBAL_CFG_TX_DMA_EN);
+	for (timo = 1000; timo > 0; timo--) {
+		if ((TXQ_READ(q, QDMA_GLOBAL_CFG) &
+		    QDMA_GLOBAL_CFG_TX_DMA_BUSY) == 0)
+			break;
+		delay(10);
+	}
+	if (timo == 0) {
+		printf("%s: QDMA%d Tx stop timeout\n", DEVNAME(sc), q->q_id);
+		sc->sc_dma_failed = 1;
+	}
+	TXQ_WRITE(q, QDMA_INT_ENABLE0, 0);
+	if (q->q_ih)
+		intr_barrier(q->q_ih);
+	/* A busy engine may still access its buffers.  Keep them mapped. */
+	if (timo == 0)
+		return;
+
+	for (i = 0; i < AIRETH_NTXDESC; i++) {
+		txb = &q->q_buf[i];
+		if (txb->tb_m) {
+			bus_dmamap_sync(sc->sc_dmat, txb->tb_map, 0,
+			    txb->tb_map->dm_mapsize, BUS_DMASYNC_POSTWRITE);
+			bus_dmamap_unload(sc->sc_dmat, txb->tb_map);
+			m_freem(txb->tb_m);
+			txb->tb_m = NULL;
+		}
+	}
+}
+
+void
+aireth_start(struct ifqueue *ifq)
+{
+	struct ifnet *ifp = ifq->ifq_if;
+	struct aireth_port *ap = ifp->if_softc;
+	struct aireth_txq *q = ap->ap_txq;
+	struct mbuf *m;
+	int error, idx, left, used;
+
+	if (!(ifp->if_flags & IFF_RUNNING))
+		return;
+	if (ifq_is_oactive(&ifp->if_snd))
+		return;
+	if (ifq_empty(&ifp->if_snd))
+		return;
+
+	mtx_enter(&q->q_mtx);
+	idx = q->q_prod;
+	left = q->q_cons;
+	if (left <= idx)
+		left += AIRETH_NTXDESC;
+	left -= idx;
+	used = 0;
+
+	for (;;) {
+		/* The ring must never become completely full. */
+		if (used + AIRETH_NTXSEGS + 1 > left) {
+			ifq_set_oactive(ifq);
+			break;
+		}
+
+		m = ifq_dequeue(ifq);
+		if (m == NULL)
+			break;
+
+		error = aireth_encap(q, ap, m, &idx, &used);
+		if (error == EFBIG) {
+			m_freem(m); /* give up: drop it */
+			ifp->if_oerrors++;
+			continue;
+		}
+
+#if NBPFILTER > 0
+		if (ifp->if_bpf)
+			bpf_mtap(ifp->if_bpf, m, BPF_DIRECTION_OUT);
+#endif
+	}
+
+	if (q->q_prod != idx) {
+		q->q_prod = idx;
+
+		/* Set a timeout in case the chip goes out to lunch. */
+		ifp->if_timer = 5;
+
+		TXQ_WRITE(q, QDMA_TX_CPU_IDX, idx);
+	}
+	mtx_leave(&q->q_mtx);
+}
+
+int
+aireth_ioctl(struct ifnet *ifp, u_long cmd, caddr_t addr)
+{
+	struct aireth_port *ap = ifp->if_softc;
+	struct aireth_softc *sc = ap->ap_sc;
+	struct ifreq *ifr = (struct ifreq *)addr;
+	int error = 0, s;
+
+	s = splnet();
+
+	switch (cmd) {
+	case SIOCSIFADDR:
+		ifp->if_flags |= IFF_UP;
+		/* FALLTHROUGH */
+	case SIOCSIFFLAGS:
+		if (ifp->if_flags & IFF_UP) {
+			if (ifp->if_flags & IFF_RUNNING)
+				error = ENETRESET;
+			else
+				error = aireth_port_up(ap);
+		} else {
+			if (ifp->if_flags & IFF_RUNNING)
+				aireth_port_down(ap);
+		}
+		/* "ifconfig aireth0 debug" dumps the counters. */
+		if (ifp->if_flags & IFF_DEBUG)
+			aireth_dump(sc);
+		break;
+
+	case SIOCGIFMEDIA:
+	case SIOCSIFMEDIA:
+		error = ifmedia_ioctl(ifp, ifr, &ap->ap_media, cmd);
+		break;
+
+	case SIOCGIFRXR:
+		error = if_rxr_ioctl((struct if_rxrinfo *)ifr->ifr_data,
+		    NULL, MCLBYTES, &sc->sc_rx_ring);
+		break;
+
+	default:
+		error = ether_ioctl(ifp, &ap->ap_ac, cmd, addr);
+		break;
+	}
+
+	/*
+	 * The GDMs forward all frames to the CPU, so there is no
+	 * receive filter to program.
+	 */
+	if (error == ENETRESET)
+		error = 0;
+
+	splx(s);
+	return (error);
+}
+
+void
+aireth_watchdog(struct ifnet *ifp)
+{
+	printf("%s: watchdog timeout\n", ifp->if_xname);
+	ifp->if_oerrors++;
+}
+
+int
+aireth_media_change(struct ifnet *ifp)
+{
+	struct aireth_port *ap = ifp->if_softc;
+
+	if (ap->ap_phy != -1 && (ifp->if_flags & IFF_RUNNING))
+		return en8811_aneg(&ap->ap_phydev);
+	return (0);
+}
+
+void
+aireth_media_status(struct ifnet *ifp, struct ifmediareq *ifmr)
+{
+	struct aireth_port *ap = ifp->if_softc;
+
+	ifmr->ifm_status = IFM_AVALID;
+	ifmr->ifm_active = ap->ap_active;
+	if ((ifp->if_flags & IFF_RUNNING) &&
+	    LINK_STATE_IS_UP(ifp->if_link_state))
+		ifmr->ifm_status |= IFM_ACTIVE;
+}
+
+void
+aireth_rxtick(void *arg)
+{
+	struct aireth_softc *sc = arg;
+	struct aireth_desc *rxd;
+	int s;
+
+	s = splnet();
+	/*
+	 * XXX Also poll the Rx ring every tick: the Rx done interrupt
+	 * has not been seen to fire after a kexec from Linux.  Count
+	 * what the interrupt should already have handled.
+	 */
+	mtx_enter(&sc->sc_rx_mtx);
+	if (sc->sc_nup > 0) {
+		bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(sc->sc_rxring), 0,
+		    AIRETH_DMA_LEN(sc->sc_rxring), BUS_DMASYNC_POSTREAD);
+		rxd = &sc->sc_rxdesc[sc->sc_rx_cons];
+		if (letoh32(rxd->ctrl) & AIRETH_CTRL_DONE)
+			sc->sc_rxpoll_hits++;
+		aireth_rx_proc(sc);
+		timeout_add(&sc->sc_rxto, 1);
+	} else
+		aireth_fill_rx_ring(sc);
+	mtx_leave(&sc->sc_rx_mtx);
+	splx(s);
+}
+
+int
+aireth_intr(void *arg)
+{
+	struct aireth_softc *sc = arg;
+	uint32_t intr1;
+	int handled;
+
+	handled = aireth_intr_txq(&sc->sc_txq[0]);
+
+	intr1 = QDMA_READ(sc, QDMA_INT_STATUS1) & QDMA_INT1_RX0_DONE;
+	if (intr1) {
+		QDMA_WRITE(sc, QDMA_INT_STATUS1, intr1);
+		mtx_enter(&sc->sc_rx_mtx);
+		aireth_rx_proc(sc);
+		mtx_leave(&sc->sc_rx_mtx);
+		handled = 1;
+	}
+
+	return (handled);
+}
+
+/* Tx completions of one QDMA (bank 0, IRQ0). */
+int
+aireth_intr_txq(void *arg)
+{
+	struct aireth_txq *q = arg;
+	uint32_t intr0, status;
+	int head, len, i, n;
+
+	intr0 = TXQ_READ(q, QDMA_INT_STATUS0) &
+	    (QDMA_INT0_IRQ0 | QDMA_INT0_IRQ0_FULL);
+	if (intr0 == 0)
+		return (0);
+	TXQ_WRITE(q, QDMA_INT_STATUS0, intr0);
+
+	/*
+	 * Consume the Tx completion queue.  Descriptors are completed
+	 * in order, so the entries themselves are not needed; the ring
+	 * is scanned instead.
+	 */
+	status = TXQ_READ(q, QDMA_IRQ_STATUS);
+	head = QDMA_IRQ_STATUS_HEAD(status) % AIRETH_NIRQ;
+	len = QDMA_IRQ_STATUS_ENTRY_LEN(status);
+	while (len > 0) {
+		n = MIN(len, 0x80);
+		for (i = 0; i < n; i++) {
+			q->q_irq[head] = 0xffffffff;
+			head = (head + 1) % AIRETH_NIRQ;
+		}
+		TXQ_WRITE(q, QDMA_IRQ_CLEAR_LEN, n);
+		len -= n;
+	}
+
+	aireth_tx_proc(q);
+	return (1);
+}
+
+void
+aireth_tx_proc(struct aireth_txq *q)
+{
+	struct aireth_softc *sc = q->q_sc;
+	struct aireth_desc *txd;
+	struct aireth_buf *txb;
+	struct aireth_port *ap;
+	struct ifnet *ifp;
+	int i, idx, txfree;
+
+	if (sc->sc_nup == 0)
+		return;
+
+	mtx_enter(&q->q_mtx);
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(q->q_ring), 0,
+	    AIRETH_DMA_LEN(q->q_ring),
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+
+	txfree = 0;
+	while (q->q_cons != q->q_prod) {
+		idx = q->q_cons;
+		KASSERT(idx < AIRETH_NTXDESC);
+
+		txd = &q->q_desc[idx];
+		if ((letoh32(txd->ctrl) &
+		    (AIRETH_CTRL_DONE | AIRETH_CTRL_DROP)) == 0)
+			break;
+
+		txb = &q->q_buf[idx];
+		if (txb->tb_m) {
+			bus_dmamap_sync(sc->sc_dmat, txb->tb_map, 0,
+			    txb->tb_map->dm_mapsize, BUS_DMASYNC_POSTWRITE);
+			bus_dmamap_unload(sc->sc_dmat, txb->tb_map);
+
+			m_freem(txb->tb_m);
+			txb->tb_m = NULL;
+		}
+
+		txfree++;
+
+		if (q->q_cons == (AIRETH_NTXDESC - 1))
+			q->q_cons = 0;
+		else
+			q->q_cons++;
+	}
+	mtx_leave(&q->q_mtx);
+
+	for (i = 0; i < sc->sc_nports; i++) {
+		ap = &sc->sc_ports[i];
+		if (ap->ap_txq != q)
+			continue;
+		ifp = &ap->ap_ac.ac_if;
+		if (q->q_cons == q->q_prod)
+			ifp->if_timer = 0;
+		if (txfree && ifq_is_oactive(&ifp->if_snd))
+			ifq_restart(&ifp->if_snd);
+	}
+}
+
+void
+aireth_rx_proc(struct aireth_softc *sc)
+{
+	struct aireth_desc *rxd;
+	struct aireth_buf *rxb;
+	struct mbuf_list ml[AIRETH_NPORTS];
+	struct aireth_port *ap;
+	struct ifnet *ifp;
+	struct mbuf *m;
+	uint32_t ctrl, sport;
+	int i, idx, len, cnt, put, livelocked = 0;
+
+	if (sc->sc_nup == 0)
+		return;
+
+	for (i = 0; i < AIRETH_NPORTS; i++)
+		ml_init(&ml[i]);
+
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(sc->sc_rxring), 0,
+	    AIRETH_DMA_LEN(sc->sc_rxring),
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+
+	cnt = if_rxr_inuse(&sc->sc_rx_ring);
+	put = 0;
+	while (put < cnt) {
+		idx = sc->sc_rx_cons;
+		KASSERT(idx < AIRETH_NRXDESC);
+
+		rxd = &sc->sc_rxdesc[idx];
+		ctrl = letoh32(rxd->ctrl);
+		if ((ctrl & AIRETH_CTRL_DONE) == 0)
+			break;
+
+		len = ctrl & AIRETH_CTRL_LEN_MASK;
+		sport = AIRETH_RXMSG1_SPORT(letoh32(rxd->msg1));
+		rxb = &sc->sc_rxbuf[idx];
+		KASSERT(rxb->tb_m);
+
+		bus_dmamap_sync(sc->sc_dmat, rxb->tb_map, 0,
+		    rxb->tb_map->dm_mapsize, BUS_DMASYNC_POSTREAD);
+		bus_dmamap_unload(sc->sc_dmat, rxb->tb_map);
+
+		m = rxb->tb_m;
+		rxb->tb_m = NULL;
+
+		/*
+		 * The QDMA splits some frames over several buffers
+		 * (MORE set on all but the last), as Linux expects too;
+		 * chain them.  The first fragment carries the port.
+		 */
+		if (sc->sc_rx_head == NULL) {
+			sc->sc_rxsport[sport]++;
+			sc->sc_rx_port = (sport == AIRETH_SPORT_GDM4 &&
+			    sc->sc_nports > 1) ? 1 : 0;
+		}
+		i = sc->sc_rx_port;
+		ap = &sc->sc_ports[i];
+		ifp = &ap->ap_ac.ac_if;
+
+		if (len == 0 || len > m->m_len) {
+			if (len == 0)
+				sc->sc_rxerr_len++;
+			else
+				sc->sc_rxerr_big++;
+			ifp->if_ierrors++;
+			m_freem(m);
+			m_freem(sc->sc_rx_head);
+			sc->sc_rx_head = sc->sc_rx_tail = NULL;
+			goto next;
+		}
+
+		m->m_len = len;
+		if (sc->sc_rx_head == NULL) {
+			m->m_pkthdr.len = len;
+			sc->sc_rx_head = sc->sc_rx_tail = m;
+		} else {
+			m->m_flags &= ~M_PKTHDR;
+			sc->sc_rx_tail->m_next = m;
+			sc->sc_rx_tail = m;
+			sc->sc_rx_head->m_pkthdr.len += len;
+		}
+		if ((ctrl & AIRETH_CTRL_MORE) || sc->sc_rx_head != m) {
+			sc->sc_rxfraglen[sc->sc_rxfragidx++ %
+			    nitems(sc->sc_rxfraglen)] = len;
+		}
+		if (ctrl & AIRETH_CTRL_MORE)
+			goto next;
+
+		m = sc->sc_rx_head;
+		sc->sc_rx_head = sc->sc_rx_tail = NULL;
+		if (m->m_next != NULL)
+			sc->sc_rxfrags++;
+		if ((ifp->if_flags & IFF_RUNNING) == 0)
+			m_freem(m);
+		else
+			ml_enqueue(&ml[i], m);
+next:
+
+		put++;
+		if (sc->sc_rx_cons == (AIRETH_NRXDESC - 1))
+			sc->sc_rx_cons = 0;
+		else
+			sc->sc_rx_cons++;
+	}
+
+	if_rxr_put(&sc->sc_rx_ring, put);
+	for (i = 0; i < sc->sc_nports; i++) {
+		ifp = &sc->sc_ports[i].ap_ac.ac_if;
+		if (!ml_empty(&ml[i]) && ifiq_input(&ifp->if_rcv, &ml[i]))
+			livelocked = 1;
+	}
+	if (livelocked)
+		if_rxr_livelocked(&sc->sc_rx_ring);
+
+	aireth_fill_rx_ring(sc);
+}
+
+void
+aireth_up(struct aireth_softc *sc)
+{
+	int i;
+
+	memset(sc->sc_rxdesc, 0, AIRETH_NRXDESC * sizeof(struct aireth_desc));
+
+	/* One slot is kept empty to tell a full ring from an empty one. */
+	/*
+	 * Start above QDMA_RX_RING_THR (32): with fewer free descriptors
+	 * the QDMA reports RX0_NO_CPU_DSCP instead of using them.
+	 */
+	if_rxr_init(&sc->sc_rx_ring, 64, AIRETH_NRXDESC - 1);
+
+	sc->sc_rx_prod = sc->sc_rx_cons = 0;
+	m_freem(sc->sc_rx_head);
+	sc->sc_rx_head = sc->sc_rx_tail = NULL;
+	QDMA_WRITE(sc, QDMA_RX_DMA_IDX, 0);
+	QDMA_WRITE(sc, QDMA_RX_CPU_IDX, 0);
+	aireth_fill_rx_ring(sc);
+
+	QDMA_WRITE(sc, QDMA_INT_STATUS1, 0xffffffff);
+	QDMA_WRITE(sc, QDMA_INT_ENABLE1, QDMA_INT1_RX0_DONE);
+
+	aireth_quiesce_rx_rings(sc);
+	QDMA_WRITE(sc, QDMA_GLOBAL_CFG, QDMA_READ(sc, QDMA_GLOBAL_CFG) |
+	    QDMA_GLOBAL_CFG_RX_DMA_EN);
+	for (i = 0; i < sc->sc_ntxq; i++)
+		aireth_txq_up(&sc->sc_txq[i]);
+
+	timeout_add(&sc->sc_rxto, 1);
+}
+
+int
+aireth_port_up(struct aireth_port *ap)
+{
+	struct aireth_softc *sc = ap->ap_sc;
+	struct ifnet *ifp = &ap->ap_ac.ac_if;
+	uint32_t val;
+	int error;
+
+	/* Timed-out DMA still owns buffers and descriptors: don't reuse them. */
+	if (sc->sc_dma_failed)
+		return EIO;
+	if (ap->ap_phy != -1 &&
+	    (error = en8811_aneg(&ap->ap_phydev)) != 0)
+		return error;
+
+	if (sc->sc_nup++ == 0)
+		aireth_up(sc);
+
+	ifp->if_flags |= IFF_RUNNING;
+	ifq_clr_oactive(&ifp->if_snd);
+
+	/* Deliver this port's frames to CDM1, QDMA0 Rx ring 0. */
+	val = FE_READ(sc, FE_GDM_FWD_CFG(ap->ap_gdm));
+	FE_WRITE(sc, FE_GDM_FWD_CFG(ap->ap_gdm),
+	    val & ~FE_GDM_FWD_CFG_QSEL_MASK);
+
+	if (ap->ap_phy == -1) {
+		ifp->if_link_state = LINK_STATE_FULL_DUPLEX;
+		if_link_state_change(ifp);
+	} else
+		aireth_port_tick(ap);
+	return 0;
+}
+
+void
+aireth_port_down(struct aireth_port *ap)
+{
+	struct aireth_softc *sc = ap->ap_sc;
+	struct ifnet *ifp = &ap->ap_ac.ac_if;
+	uint32_t val;
+
+	if (ap->ap_phy != -1)
+		timeout_del_barrier(&ap->ap_tick);
+#if NAIRPCS > 0
+	if (ap->ap_pcs != NULL)
+		airpcs_down(ap->ap_pcs);
+#endif
+	val = FE_READ(sc, FE_GDM_FWD_CFG(ap->ap_gdm));
+	FE_WRITE(sc, FE_GDM_FWD_CFG(ap->ap_gdm),
+	    val | FE_GDM_FWD_CFG_DROP);
+
+	ifp->if_flags &= ~IFF_RUNNING;
+	ifq_clr_oactive(&ifp->if_snd);
+	ifp->if_timer = 0;
+	ifp->if_link_state = LINK_STATE_DOWN;
+	if_link_state_change(ifp);
+	ifq_barrier(&ifp->if_snd);
+
+	if (--sc->sc_nup == 0)
+		aireth_down(sc);
+}
+
+void
+aireth_down(struct aireth_softc *sc)
+{
+	struct aireth_buf *rxb;
+	int i, timo;
+
+	timeout_del_barrier(&sc->sc_rxto);
+
+	for (i = 0; i < sc->sc_ntxq; i++)
+		aireth_txq_down(&sc->sc_txq[i]);
+
+	QDMA_WRITE(sc, QDMA_GLOBAL_CFG, QDMA_READ(sc, QDMA_GLOBAL_CFG) &
+	    ~QDMA_GLOBAL_CFG_RX_DMA_EN);
+	for (timo = 1000; timo > 0; timo--) {
+		if ((QDMA_READ(sc, QDMA_GLOBAL_CFG) &
+		    QDMA_GLOBAL_CFG_RX_DMA_BUSY) == 0)
+			break;
+		delay(10);
+	}
+	if (timo == 0) {
+		printf("%s: Rx DMA stop timeout\n", DEVNAME(sc));
+		sc->sc_dma_failed = 1;
+	}
+	QDMA_WRITE(sc, QDMA_INT_ENABLE1, 0);
+	intr_barrier(sc->sc_ih);
+	/* Retain the buffers until the engine can no longer write to them. */
+	if (timo == 0)
+		return;
+
+	for (i = 0; i < AIRETH_NRXDESC; i++) {
+		rxb = &sc->sc_rxbuf[i];
+		if (rxb->tb_m) {
+			bus_dmamap_sync(sc->sc_dmat, rxb->tb_map, 0,
+			    rxb->tb_map->dm_mapsize, BUS_DMASYNC_POSTREAD);
+			bus_dmamap_unload(sc->sc_dmat, rxb->tb_map);
+			m_freem(rxb->tb_m);
+			rxb->tb_m = NULL;
+		}
+	}
+}
+
+int
+aireth_encap(struct aireth_txq *q, struct aireth_port *ap, struct mbuf *m,
+    int *idx, int *used)
+{
+	struct aireth_softc *sc = q->q_sc;
+	struct aireth_desc *txd;
+	bus_dmamap_t map;
+	uint32_t ctrl;
+	int cur, frag, i;
+
+	cur = frag = *idx;
+	map = q->q_buf[cur].tb_map;
+
+	if (bus_dmamap_load_mbuf(sc->sc_dmat, map, m, BUS_DMA_NOWAIT)) {
+		if (m_defrag(m, M_DONTWAIT))
+			return (EFBIG);
+		if (bus_dmamap_load_mbuf(sc->sc_dmat, map, m, BUS_DMA_NOWAIT))
+			return (EFBIG);
+	}
+
+	bus_dmamap_sync(sc->sc_dmat, map, 0, map->dm_mapsize,
+	    BUS_DMASYNC_PREWRITE);
+
+	for (i = 0; i < map->dm_nsegs; i++) {
+		txd = &q->q_desc[frag];
+		cur = frag;
+		if (frag == (AIRETH_NTXDESC - 1))
+			frag = 0;
+		else
+			frag++;
+
+		ctrl = map->dm_segs[i].ds_len & AIRETH_CTRL_LEN_MASK;
+		if (i != map->dm_nsegs - 1)
+			ctrl |= AIRETH_CTRL_MORE;
+
+		txd->addr = htole32(map->dm_segs[i].ds_addr);
+		txd->data = htole32(frag);
+		txd->msg0 = 0;
+		txd->msg1 = htole32(AIRETH_TXMSG1_METER(0x7f) |
+		    AIRETH_TXMSG1_FPORT(ap->ap_fport));
+		txd->msg2 = htole32(0xffff);
+		txd->msg3 = 0;
+		txd->ctrl = htole32(ctrl);
+	}
+
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(q->q_ring), 0,
+	    AIRETH_DMA_LEN(q->q_ring), BUS_DMASYNC_PREWRITE);
+
+	/* Keep the map and mbuf together in the last slot. */
+	KASSERT(q->q_buf[cur].tb_m == NULL);
+	q->q_buf[*idx].tb_map = q->q_buf[cur].tb_map;
+	q->q_buf[cur].tb_map = map;
+	q->q_buf[cur].tb_m = m;
+
+	*idx = frag;
+	*used += map->dm_nsegs;
+
+	return (0);
+}
+
+struct aireth_dmamem *
+aireth_dmamem_alloc(struct aireth_softc *sc, bus_size_t size, bus_size_t align)
+{
+	struct aireth_dmamem *tdm;
+	int nsegs;
+
+	tdm = malloc(sizeof(*tdm), M_DEVBUF, M_WAITOK | M_ZERO);
+	tdm->tdm_size = size;
+
+	if (bus_dmamap_create(sc->sc_dmat, size, 1, size, 0,
+	    BUS_DMA_WAITOK | BUS_DMA_ALLOCNOW, &tdm->tdm_map) != 0)
+		goto tdmfree;
+
+	if (bus_dmamem_alloc(sc->sc_dmat, size, align, 0, &tdm->tdm_seg, 1,
+	    &nsegs, BUS_DMA_WAITOK) != 0)
+		goto destroy;
+
+	if (bus_dmamem_map(sc->sc_dmat, &tdm->tdm_seg, nsegs, size,
+	    &tdm->tdm_kva, BUS_DMA_WAITOK | BUS_DMA_COHERENT) != 0)
+		goto free;
+
+	if (bus_dmamap_load(sc->sc_dmat, tdm->tdm_map, tdm->tdm_kva, size,
+	    NULL, BUS_DMA_WAITOK) != 0)
+		goto unmap;
+
+	bzero(tdm->tdm_kva, size);
+
+	return (tdm);
+
+unmap:
+	bus_dmamem_unmap(sc->sc_dmat, tdm->tdm_kva, size);
+free:
+	bus_dmamem_free(sc->sc_dmat, &tdm->tdm_seg, 1);
+destroy:
+	bus_dmamap_destroy(sc->sc_dmat, tdm->tdm_map);
+tdmfree:
+	free(tdm, M_DEVBUF, sizeof(*tdm));
+
+	return (NULL);
+}
+
+void
+aireth_dmamem_free(struct aireth_softc *sc, struct aireth_dmamem *tdm)
+{
+	bus_dmamap_unload(sc->sc_dmat, tdm->tdm_map);
+	bus_dmamem_unmap(sc->sc_dmat, tdm->tdm_kva, tdm->tdm_size);
+	bus_dmamem_free(sc->sc_dmat, &tdm->tdm_seg, 1);
+	bus_dmamap_destroy(sc->sc_dmat, tdm->tdm_map);
+	free(tdm, M_DEVBUF, sizeof(*tdm));
+}
+
+struct mbuf *
+aireth_alloc_mbuf(struct aireth_softc *sc, bus_dmamap_t map)
+{
+	struct mbuf *m = NULL;
+
+	m = MCLGETL(NULL, M_DONTWAIT, MCLBYTES);
+	if (!m)
+		return (NULL);
+	m->m_len = m->m_pkthdr.len = MCLBYTES;
+
+	if (bus_dmamap_load_mbuf(sc->sc_dmat, map, m, BUS_DMA_NOWAIT) != 0) {
+		printf("%s: could not load mbuf DMA map", DEVNAME(sc));
+		m_freem(m);
+		return (NULL);
+	}
+
+	bus_dmamap_sync(sc->sc_dmat, map, 0,
+	    m->m_pkthdr.len, BUS_DMASYNC_PREREAD);
+
+	return (m);
+}
+
+void
+aireth_fill_rx_ring(struct aireth_softc *sc)
+{
+	struct aireth_desc *rxd;
+	struct aireth_buf *rxb;
+	u_int slots;
+	int prod;
+
+	prod = sc->sc_rx_prod;
+	for (slots = if_rxr_get(&sc->sc_rx_ring, AIRETH_NRXDESC - 1);
+	    slots > 0; slots--) {
+		rxb = &sc->sc_rxbuf[sc->sc_rx_prod];
+		rxb->tb_m = aireth_alloc_mbuf(sc, rxb->tb_map);
+		if (rxb->tb_m == NULL)
+			break;
+
+		rxd = &sc->sc_rxdesc[sc->sc_rx_prod];
+
+		if (sc->sc_rx_prod == (AIRETH_NRXDESC - 1))
+			sc->sc_rx_prod = 0;
+		else
+			sc->sc_rx_prod++;
+
+		rxd->addr = htole32(rxb->tb_map->dm_segs[0].ds_addr);
+		rxd->data = htole32(sc->sc_rx_prod);
+		rxd->msg0 = rxd->msg1 = rxd->msg2 = rxd->msg3 = 0;
+		rxd->ctrl = htole32(rxb->tb_map->dm_segs[0].ds_len &
+		    AIRETH_CTRL_LEN_MASK);
+	}
+	if_rxr_put(&sc->sc_rx_ring, slots);
+
+	if (sc->sc_rx_prod != prod) {
+		bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(sc->sc_rxring), 0,
+		    AIRETH_DMA_LEN(sc->sc_rxring),
+		    BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE);
+		QDMA_WRITE(sc, QDMA_RX_CPU_IDX, sc->sc_rx_prod);
+	}
+
+	if (if_rxr_inuse(&sc->sc_rx_ring) == 0)
+		timeout_add(&sc->sc_rxto, 1);
+}
+
+/*
+ * Rx DMA is enabled for all 32 rings at once, and the QDMA reset does
+ * not clear them: rings Linux set up before a kexec still point at its
+ * buffers, which are now our memory.  Leave them no free descriptor
+ * (CPU index == DMA index) and forget them.
+ */
+int
+aireth_quiesce_rings(struct aireth_softc *sc, bus_space_handle_t ioh,
+    int first)
+{
+	uint32_t idx;
+	int n, cnt = 0;
+
+	for (n = first; n < QDMA_NRXRINGS; n++) {
+		if (bus_space_read_4(sc->sc_iot, ioh,
+		    QDMA_RXN(n, QDMA_RX_RING_BASE)) == 0)
+			continue;
+		idx = bus_space_read_4(sc->sc_iot, ioh,
+		    QDMA_RXN(n, QDMA_RX_DMA_IDX)) & QDMA_RX_IDX_MASK;
+		bus_space_write_4(sc->sc_iot, ioh,
+		    QDMA_RXN(n, QDMA_RX_CPU_IDX), idx);
+		bus_space_write_4(sc->sc_iot, ioh,
+		    QDMA_RXN(n, QDMA_RX_RING_SIZE), 0);
+		bus_space_write_4(sc->sc_iot, ioh,
+		    QDMA_RXN(n, QDMA_RX_RING_BASE), 0);
+		cnt++;
+	}
+	return cnt;
+}
+
+void
+aireth_quiesce_rx_rings(struct aireth_softc *sc)
+{
+	int cnt;
+
+	cnt = aireth_quiesce_rings(sc, sc->sc_qdma_ioh, 1);	/* not ring 0 */
+	if (cnt > 0)
+		printf("%s: disabled %d stale QDMA0 Rx rings\n",
+		    DEVNAME(sc), cnt);
+}
+
+/* Stop either QDMA before changing any of its ring registers. */
+int
+aireth_stop_qdma(struct aireth_softc *sc, bus_space_handle_t ioh)
+{
+	uint32_t val;
+	int timo, n, bank;
+
+	for (n = 0; n < 5; n++)
+		for (bank = 0; bank < 4; bank++)
+			bus_space_write_4(sc->sc_iot, ioh,
+			    QDMA_INT_ENABLE(bank, n), 0);
+	val = bus_space_read_4(sc->sc_iot, ioh, QDMA_GLOBAL_CFG);
+	bus_space_write_4(sc->sc_iot, ioh, QDMA_GLOBAL_CFG,
+	    val & ~(QDMA_GLOBAL_CFG_TX_DMA_EN | QDMA_GLOBAL_CFG_RX_DMA_EN));
+	for (timo = 1000; timo > 0; timo--) {
+		if ((bus_space_read_4(sc->sc_iot, ioh, QDMA_GLOBAL_CFG) &
+		    (QDMA_GLOBAL_CFG_TX_DMA_BUSY |
+		    QDMA_GLOBAL_CFG_RX_DMA_BUSY)) == 0)
+			break;
+		delay(10);
+	}
+	if (timo == 0)
+		return ETIMEDOUT;
+	aireth_quiesce_rings(sc, ioh, 0);
+	for (n = 0; n < 5; n++)
+		bus_space_write_4(sc->sc_iot, ioh,
+		    QDMA_INT_STATUS(n), 0xffffffff);
+	return 0;
+}
+
+/*
+ * Counters along the receive path, outermost first: switch ports, the
+ * GDM1 MAC facing the switch, then the QDMA ring indices.
+ */
+void
+aireth_dump(struct aireth_softc *sc)
+{
+	bus_size_t b;
+	int g, i, idx;
+
+#if NAIRSW > 0
+	airsw_dump();
+#endif
+	for (i = 0; i < sc->sc_nports; i++) {
+		g = sc->sc_ports[i].ap_gdm;
+#if NAIRPCS > 0
+		if (sc->sc_ports[i].ap_pcs != NULL)
+			airpcs_dump(sc->sc_ports[i].ap_pcs);
+#endif
+		b = FE_GDM_BASE(g);
+		printf("%s: GDM%d rx ok %u eth %u bc %u drop eth %u fc %u "
+		    "rc %u ovf %u err %u\n", sc->sc_ports[i].ap_ac.ac_if.if_xname,
+		    g, FE_READ(sc, b + FE_GDM_RX_OK_PKT_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_ETH_PKT_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_ETH_BC_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_ETH_DROP_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_FC_DROP_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_RC_DROP_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_OVERFLOW_DROP_CNT),
+		    FE_READ(sc, b + FE_GDM_RX_ERROR_DROP_CNT));
+		printf("%s: GDM%d tx ok %u eth %u drop %u; fwd 0x%08x "
+		    "ingress 0x%08x len 0x%08x\n",
+		    sc->sc_ports[i].ap_ac.ac_if.if_xname, g,
+		    FE_READ(sc, b + FE_GDM_TX_OK_PKT_CNT),
+		    FE_READ(sc, b + FE_GDM_TX_ETH_PKT_CNT),
+		    FE_READ(sc, b + FE_GDM_TX_ETH_DROP_CNT),
+		    FE_READ(sc, FE_GDM_FWD_CFG(g)),
+		    FE_READ(sc, FE_GDM_INGRESS_CFG(g)),
+		    FE_READ(sc, FE_GDM_LEN_CFG(g)));
+	}
+	printf("%s: dma_glo 0x%08x\n", DEVNAME(sc), FE_READ(sc, FE_DMA_GLO_CFG));
+	printf("%s: vip 0x%08x ifc 0x%08x wan cpu 0x%08x sport 0x%08x\n",
+	    DEVNAME(sc), FE_READ(sc, FE_VIP_PORT_EN),
+	    FE_READ(sc, FE_IFC_PORT_EN), FE_READ(sc, FE_SP_DFT_CPORT(3)),
+	    FE_READ(sc, FE_GDM_SRC_PORT_SET(4)));
+	printf("%s: PSE limit %u buf 0x%08x thresholds 0x%08x\n",
+	    DEVNAME(sc), FE_READ(sc, FE_PSE_FQ_CFG) & FE_PSE_FQ_LIMIT_MASK,
+	    FE_READ(sc, FE_PSE_BUF_SET), FE_READ(sc, FE_PSE_SHARE_THD));
+	printf("%s: QDMA glo 0x%08x int0 0x%08x/0x%08x int1 0x%08x/0x%08x "
+	    "(status/enable)\n", DEVNAME(sc),
+	    QDMA_READ(sc, QDMA_GLOBAL_CFG),
+	    QDMA_READ(sc, QDMA_INT_STATUS0), QDMA_READ(sc, QDMA_INT_ENABLE0),
+	    QDMA_READ(sc, QDMA_INT_STATUS1), QDMA_READ(sc, QDMA_INT_ENABLE1));
+	printf("%s: rx cpu %u dma %u prod %d cons %d inuse %u poll hits %u "
+	    "frag %u len0 %u big %u; tx cpu %u dma %u\n", DEVNAME(sc),
+	    QDMA_READ(sc, QDMA_RX_CPU_IDX), QDMA_READ(sc, QDMA_RX_DMA_IDX),
+	    sc->sc_rx_prod, sc->sc_rx_cons, if_rxr_inuse(&sc->sc_rx_ring),
+	    sc->sc_rxpoll_hits,
+	    sc->sc_rxfrags, sc->sc_rxerr_len, sc->sc_rxerr_big,
+	    QDMA_READ(sc, QDMA_TX_CPU_IDX), QDMA_READ(sc, QDMA_TX_DMA_IDX));
+	printf("%s: rx reassembled %u, last fragment lengths", DEVNAME(sc),
+	    sc->sc_rxfrags);
+	for (i = 0; i < nitems(sc->sc_rxfraglen); i++)
+		printf(" %u", sc->sc_rxfraglen[(sc->sc_rxfragidx + i) %
+		    nitems(sc->sc_rxfraglen)]);
+	printf("; frames by source port:");
+	for (i = 0; i < nitems(sc->sc_rxsport); i++)
+		if (sc->sc_rxsport[i])
+			printf(" 0x%02x:%u", i, sc->sc_rxsport[i]);
+	printf("\n");
+	for (i = 1; i < sc->sc_ntxq; i++)
+		printf("%s: QDMA%d glo 0x%08x int0 0x%08x/0x%08x "
+		    "tx cpu %u dma %u prod %d cons %d\n", DEVNAME(sc), i,
+		    TXQ_READ(&sc->sc_txq[i], QDMA_GLOBAL_CFG),
+		    TXQ_READ(&sc->sc_txq[i], QDMA_INT_STATUS0),
+		    TXQ_READ(&sc->sc_txq[i], QDMA_INT_ENABLE0),
+		    TXQ_READ(&sc->sc_txq[i], QDMA_TX_CPU_IDX),
+		    TXQ_READ(&sc->sc_txq[i], QDMA_TX_DMA_IDX),
+		    sc->sc_txq[i].q_prod, sc->sc_txq[i].q_cons);
+	bus_dmamap_sync(sc->sc_dmat, AIRETH_DMA_MAP(sc->sc_rxring), 0,
+	    AIRETH_DMA_LEN(sc->sc_rxring), BUS_DMASYNC_POSTREAD);
+	for (i = 1; i < QDMA_NRXRINGS; i++) {
+		if (QDMA_READ(sc, QDMA_RXN(i, QDMA_RX_RING_BASE)) == 0)
+			continue;
+		printf("%s: Rx ring %d base 0x%08x size 0x%08x cpu %u dma %u\n",
+		    DEVNAME(sc), i,
+		    QDMA_READ(sc, QDMA_RXN(i, QDMA_RX_RING_BASE)),
+		    QDMA_READ(sc, QDMA_RXN(i, QDMA_RX_RING_SIZE)),
+		    QDMA_READ(sc, QDMA_RXN(i, QDMA_RX_CPU_IDX)),
+		    QDMA_READ(sc, QDMA_RXN(i, QDMA_RX_DMA_IDX)));
+	}
+	for (i = 0; i < 4; i++) {
+		idx = (sc->sc_rx_cons + i) % AIRETH_NRXDESC;
+		printf("%s: rxd[%d] ctrl 0x%08x addr 0x%08x data 0x%08x "
+		    "msg 0x%08x 0x%08x\n", DEVNAME(sc), idx,
+		    letoh32(sc->sc_rxdesc[idx].ctrl),
+		    letoh32(sc->sc_rxdesc[idx].addr),
+		    letoh32(sc->sc_rxdesc[idx].data),
+		    letoh32(sc->sc_rxdesc[idx].msg0),
+		    letoh32(sc->sc_rxdesc[idx].msg1));
+	}
+}
diff --git a/uvm/uvm_fault.c b/uvm/uvm_fault.c
index 866b378..53eeed9 100644
--- a/uvm/uvm_fault.c
+++ b/uvm/uvm_fault.c
@@ -165,6 +165,21 @@ void	uvmfault_update_stats(struct uvm_faultinfo *);
 /*
  * inline functions
  */
+/*
+ * uvmfault_pmap_nomem: should a failed pmap allocation kill the faulting
+ * process (ENOMEM) instead of waiting and refaulting?
+ *
+ * Only when there is swap and it is full.  Without any swap (a ramdisk
+ * system) uvm_swapisfull() is always true, so a transient failure,
+ * e.g. pmap_enter() running out of PR_NOWAIT pool pages for a moment,
+ * would SIGKILL the process.
+ */
+static inline int
+uvmfault_pmap_nomem(void)
+{
+	return atomic_load_sint(&uvmexp.swpages) > 0 && uvm_swapisfull();
+}
+
 /*
  * uvmfault_anonflush: try and deactivate pages in specified anons
  *
@@ -1139,7 +1154,7 @@ retry:
 		 * as the map may change while we're asleep.
 		 */
 		uvmfault_unlockall(ufi, amap, NULL);
-		if (uvm_swapisfull()) {
+		if (uvmfault_pmap_nomem()) {
 			/* XXX instrumentation */
 			return ENOMEM;
 		}
@@ -1517,7 +1532,7 @@ uvm_fault_lower(struct uvm_faultinfo *ufi, struct uvm_faultctx *flt,
 		atomic_clearbits_int(&pg->pg_flags, PG_BUSY|PG_FAKE|PG_WANTED);
 		UVM_PAGE_OWN(pg, NULL);
 		uvmfault_unlockall(ufi, amap, uobj);
-		if (uvm_swapisfull()) {
+		if (uvmfault_pmap_nomem()) {
 			/* XXX instrumentation */
 			return (ENOMEM);
 		}
