+ */
+
+#ifndef _DEV_FDT_AIRMDIO_H_
+#define _DEV_FDT_AIRMDIO_H_
+
+#include <sys/mutex.h>
+
+/*
+ * Clause 22 transport.  Callers hold am_lock for complete transactions,
+ * including page selection/restoration and indirect Clause 45 accesses.
+ * am_read returns a 16-bit value or -1; am_write returns an errno or zero.
+ * Neither callback sleeps.
+ */
+struct air_mdio {
+	struct mutex	am_lock;
+	void		*am_cookie;
+	int		(*am_read)(void *, int, int);
+	int		(*am_write)(void *, int, int, int);
+};
+
+struct air_mdio *airsw_mdio_by_node(int);
+int	airsw_lan_ready(int);
+void	airsw_dump(void);
+
+#endif
