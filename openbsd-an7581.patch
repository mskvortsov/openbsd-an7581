+
+/*
+ * Airoha EN7581 built-in gigabit switch (MT7531 derivative).  The
+ * hardware is configured as an unmanaged switch that forwards packets
+ * between all ports, including the CPU port connected to GDM1 of
+ * aireth(4).
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+#include <sys/timeout.h>
+
+#include <machine/bus.h>
+#include <machine/fdt.h>
+
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/ofw_clock.h>
+#include <dev/ofw/ofw_misc.h>
+#include <dev/ofw/fdt.h>
+
+#include <dev/mii/mii.h>
+#include <dev/fdt/airmdio.h>
+
+/* Registers */
+#define AIRSW_MFC			0x0010
+#define  AIRSW_MFC_BC_FFP_MASK		(0xffU << 24)
+#define  AIRSW_MFC_UNM_FFP_MASK		(0xffU << 16)
+#define  AIRSW_MFC_UNU_FFP_MASK		(0xffU << 8)
+#define AIRSW_PMSR(x)			(0x3008 + (x) * 0x100)
+#define  AIRSW_PMSR_SPEED_1000		(1U << 3)
+#define  AIRSW_PMSR_SPEED_100		(1U << 2)
+#define  AIRSW_PMSR_DPX			(1U << 1)
+#define  AIRSW_PMSR_LINK		(1U << 0)
+#define AIRSW_MIB(x)			(0x4000 + (x) * 0x100)
+#define  AIRSW_MIB_TX_DROP		0x00
+#define  AIRSW_MIB_TX_UNICAST		0x08
+#define  AIRSW_MIB_TX_MULTICAST		0x0c
+#define  AIRSW_MIB_TX_BROADCAST		0x10
+#define  AIRSW_MIB_RX_DROP		0x60
+#define  AIRSW_MIB_RX_FILTERING		0x64
+#define  AIRSW_MIB_RX_UNICAST		0x68
+#define  AIRSW_MIB_RX_MULTICAST		0x6c
+#define  AIRSW_MIB_RX_BROADCAST		0x70
+#define  AIRSW_MIB_RX_CRC_ERR		0x78
+#define  AIRSW_MIB_RX_INGRESS_DROP	0xb4
+#define  AIRSW_MIB_RX_ARL_DROP		0xb8
+#define AIRSW_MIB_CCR			0x4fe0
+#define  AIRSW_MIB_CCR_FLUSH		0x000000f0
+#define  AIRSW_MIB_CCR_ACTIVATE		0x800000f0
+#define AIRSW_PMCR(x)			(0x3000 + (x) * 0x100)
+#define  AIRSW_PMCR_IPG_SHORT		(1U << 18)
+#define  AIRSW_PMCR_MAC_MODE		(1U << 16)
+#define  AIRSW_PMCR_FORCE_MODE		(1U << 15)
+#define  AIRSW_PMCR_MAC_TX_EN		(1U << 14)
+#define  AIRSW_PMCR_MAC_RX_EN		(1U << 13)
+#define  AIRSW_PMCR_BKOFF_EN		(1U << 9)
+#define  AIRSW_PMCR_BKPR_EN		(1U << 8)
+#define  AIRSW_PMCR_FORCE_RX_FC		(1U << 5)
+#define  AIRSW_PMCR_FORCE_TX_FC		(1U << 4)
+#define  AIRSW_PMCR_FORCE_SPD_1000	(2U << 2)
+#define  AIRSW_PMCR_FORCE_SPD_100		(1U << 2)
+#define  AIRSW_PMCR_FORCE_DPX		(1U << 1)
+#define  AIRSW_PMCR_FORCE_LNK		(1U << 0)
+#define AIRSW_SYS_CTRL			0x7000
+#define  AIRSW_SYS_CTRL_PHY_RST		(1U << 2)
+#define AIRSW_PHY_POLL			0x7018
+#define  AIRSW_PHY_POLL_AP_EN(x)	((x) << 24)
+#define  AIRSW_PHY_POLL_EEE_EN(x)	((x) << 16)
+#define  AIRSW_PHY_POLL_PRE_EN		(1U << 15)
+#define  AIRSW_PHY_POLL_END_ADDR(x)	((x) << 8)
+#define  AIRSW_PHY_POLL_ST_ADDR(x)	((x) << 0)
+#define AIRSW_PHY_IAC			0x701c
+#define  AIRSW_PHY_IAC_ACS_ST		(1U << 31)
+#define  AIRSW_PHY_IAC_REG(x)		((x) << 25)
+#define  AIRSW_PHY_IAC_PHY(x)		((x) << 20)
+#define  AIRSW_PHY_IAC_C22_WRITE	(0x5U << 16)
+#define  AIRSW_PHY_IAC_C22_READ		(0x9U << 16)
+#define  AIRSW_PHY_IAC_DATA_MASK	0xffff
+#define AIRSW_CREV			0x7ffc
+
+#define AIRSW_CFC		0x0004
+#define AIRSW_ATC		0x0080
+#define AIRSW_ATC_BUSY		(1U << 15)
+#define AIRSW_ATC_FLUSH		2
+#define AIRSW_SSP(p)		(0x2000 + (p) * 0x100)
+#define AIRSW_PCR(p)		(0x2004 + (p) * 0x100)
+#define AIRSW_PSC(p)		(0x200c + (p) * 0x100)
+#define AIRSW_PVC(p)		(0x2010 + (p) * 0x100)
+#define AIRSW_PVID(p)		(0x2014 + (p) * 0x100)
+#define AIRSW_GMACCR		0x30e0
+#define AIRSW_INT_EN		0x7008
+#define AIRSW_CPORT_TAG		0x7c10
+#define AIRSW_NPORTS		7
+#define AIRSW_PHY_ID		0x03a294c0
+#define AIRSW_MAC_BASE		(AIRSW_PMCR_IPG_SHORT | \
+    AIRSW_PMCR_MAC_MODE | AIRSW_PMCR_FORCE_MODE | \
+    AIRSW_PMCR_BKOFF_EN | AIRSW_PMCR_BKPR_EN)
+
+#define AIRSW_CPU_PORT			6
+
+#define HREAD4(sc, reg)							\
+	(bus_space_read_4((sc)->sc_iot, (sc)->sc_ioh, (reg)))
+#define HWRITE4(sc, reg, val)						\
+	bus_space_write_4((sc)->sc_iot, (sc)->sc_ioh, (reg), (val))
+#define HSET4(sc, reg, bits)						\
+	HWRITE4((sc), (reg), HREAD4((sc), (reg)) | (bits))
+
+struct airsw_softc {
+	struct device		sc_dev;
+	bus_space_tag_t		sc_iot;
+	bus_space_handle_t	sc_ioh;
+	int			sc_mdio_node;
+	struct air_mdio		sc_mdio;
+	struct timeout		sc_tick;
+	int			sc_gdmnode;
+	int			sc_ready;
+	uint32_t		sc_ports;
+	int			sc_phy[AIRSW_NPORTS];
+	uint32_t		sc_pmcr[AIRSW_NPORTS];
+};
+
+int	airsw_match(struct device *, void *, void *);
+void	airsw_attach(struct device *, struct device *, void *);
+
+const struct cfattach airsw_ca = {
+	sizeof (struct airsw_softc), airsw_match, airsw_attach
+};
+
+struct cfdriver airsw_cd = {
+	NULL, "airsw", DV_DULL
+};
+
+int	airsw_phy_wait(struct airsw_softc *);
+int	airsw_phy_read(void *, int, int);
+int	airsw_phy_write(void *, int, int, int);
+int	airsw_phy_enable(struct airsw_softc *, int);
+int	airsw_topology(struct airsw_softc *, int);
+int	airsw_init(struct airsw_softc *);
+int	airsw_wait(struct airsw_softc *, unsigned int, uint32_t);
+void	airsw_block(struct airsw_softc *);
+void	airsw_tick(void *);
+void	airsw_dump(void);
+
+int
+airsw_match(struct device *parent, void *match, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	return OF_is_compatible(faa->fa_node, "airoha,en7581-switch");
+}
+
+void
+airsw_attach(struct device *parent, struct device *self, void *aux)
+{
+	struct airsw_softc *sc = (struct airsw_softc *)self;
+	struct fdt_attach_args *faa = aux;
+	uint32_t resets[2], rev;
+	int error;
+
+	if (faa->fa_nreg < 1 || faa->fa_reg[0].size < 0x8000) {
+		printf(": missing or short registers\n");
+		return;
+	}
+	if (OF_getpropintarray(faa->fa_node, "resets", resets,
+	    sizeof(resets)) != sizeof(resets) || resets[1] != 46 ||
+	    regmap_byphandle(resets[0]) == NULL) {
+		printf(": missing GSW reset controller\n");
+		return;
+	}
+	if ((error = airsw_topology(sc, faa->fa_node)) != 0) {
+		printf(": invalid LAN topology: %d\n", error);
+		return;
+	}
+	sc->sc_iot = faa->fa_iot;
+	if (bus_space_map(sc->sc_iot, faa->fa_reg[0].addr,
+	    faa->fa_reg[0].size, 0, &sc->sc_ioh)) {
+		printf(": can't map registers\n");
+		return;
+	}
+	reset_assert_all(faa->fa_node);
+	delay(50);
+	reset_deassert_all(faa->fa_node);
+	delay(50);
+	rev = HREAD4(sc, AIRSW_CREV);
+	if ((rev >> 16) != 0x7530) {
+		printf(": unexpected revision 0x%08x\n", rev);
+		bus_space_unmap(sc->sc_iot, sc->sc_ioh, faa->fa_reg[0].size);
+		return;
+	}
+	printf(": rev 0x%08x, native LAN switch\n", rev);
+	mtx_init(&sc->sc_mdio.am_lock, IPL_NET);
+	sc->sc_mdio.am_cookie = sc;
+	sc->sc_mdio.am_read = airsw_phy_read;
+	sc->sc_mdio.am_write = airsw_phy_write;
+
+	/* Publish MDIO independently of whether the LAN PHYs initialize. */
+	sc->sc_mdio_node = OF_getnodebyname(faa->fa_node, "mdio");
+	error = airsw_init(sc);
+	if (error) {
+		airsw_block(sc);
+		printf("%s: LAN initialization failed: %d\n",
+		    sc->sc_dev.dv_xname, error);
+		return;
+	}
+	sc->sc_ready = 1;
+	timeout_set(&sc->sc_tick, airsw_tick, sc);
+	airsw_tick(sc);
+}
+
+int
+airsw_phy_wait(struct airsw_softc *sc)
+{
+	uint32_t val;
+	int timo;
+
+	for (timo = 1000; timo > 0; timo--) {
+		val = HREAD4(sc, AIRSW_PHY_IAC);
+		if ((val & AIRSW_PHY_IAC_ACS_ST) == 0)
+			return (val & AIRSW_PHY_IAC_DATA_MASK);
+		delay(20);
+	}
+
+	printf("%s: PHY access timeout\n", sc->sc_dev.dv_xname);
+	return -1;
+}
+
+int
+airsw_phy_read(void *cookie, int phy, int reg)
+{
+	struct airsw_softc *sc = cookie;
+
+	MUTEX_ASSERT_LOCKED(&sc->sc_mdio.am_lock);
+	if (phy < 0 || phy > 31 || reg < 0 || reg > 31)
+		return -1;
+	if (airsw_phy_wait(sc) == -1)
+		return -1;
+
+	HWRITE4(sc, AIRSW_PHY_IAC, AIRSW_PHY_IAC_ACS_ST |
+	    AIRSW_PHY_IAC_C22_READ | AIRSW_PHY_IAC_PHY(phy) |
+	    AIRSW_PHY_IAC_REG(reg));
+
+	return airsw_phy_wait(sc);
+}
+
+int
+airsw_phy_write(void *cookie, int phy, int reg, int val)
+{
+	struct airsw_softc *sc = cookie;
+
+	MUTEX_ASSERT_LOCKED(&sc->sc_mdio.am_lock);
+	if (phy < 0 || phy > 31 || reg < 0 || reg > 31)
+		return EINVAL;
+	if (airsw_phy_wait(sc) == -1)
+		return EIO;
+
+	HWRITE4(sc, AIRSW_PHY_IAC, AIRSW_PHY_IAC_ACS_ST |
+	    AIRSW_PHY_IAC_C22_WRITE | AIRSW_PHY_IAC_PHY(phy) |
+	    AIRSW_PHY_IAC_REG(reg) | (val & AIRSW_PHY_IAC_DATA_MASK));
+
+	return airsw_phy_wait(sc) == -1 ? EIO : 0;
+}
+
+/* Parse only enabled internal ports; never guess the board's wiring. */
+int
+airsw_topology(struct airsw_softc *sc, int node)
+{
+	uint32_t used = 0;
+	int ports, port, p, phy, phynode, fixed, bus;
+	char mode[16];
+
+	for (p = 0; p < AIRSW_NPORTS; p++)
+		sc->sc_phy[p] = -1;
+	ports = OF_getnodebyname(node, "ports");
+	bus = OF_getnodebyname(node, "mdio");
+	if (!ports || !OF_is_enabled(ports) || !bus || !OF_is_enabled(bus))
+		return ENODEV;
+	for (port = OF_child(ports); port; port = OF_peer(port)) {
+		if (!OF_is_enabled(port))
+			continue;
+		p = OF_getpropint(port, "reg", -1);
+		if (p < 0 || p >= AIRSW_NPORTS || (used & (1U << p)))
+			return EINVAL;
+		used |= 1U << p;
+		memset(mode, 0, sizeof(mode));
+		OF_getprop(port, "phy-mode", mode, sizeof(mode) - 1);
+		if (strcmp(mode, "internal"))
+			return EINVAL;
+		if (p == AIRSW_CPU_PORT) {
+			sc->sc_gdmnode = OF_getnodebyphandle(
+			    OF_getpropint(port, "ethernet", 0));
+			fixed = OF_getnodebyname(port, "fixed-link");
+			if (!sc->sc_gdmnode || !OF_is_enabled(sc->sc_gdmnode) ||
+			    !fixed || OF_getpropint(fixed, "speed", 0) != 10000 ||
+			    OF_getproplen(fixed, "full-duplex") != 0)
+				return EINVAL;
+			continue;
+		}
+		/* EN7581's internal copper ports are 0..4, PHY addresses 8..12. */
+		if (p > 4)
+			return EINVAL;
+		phynode = OF_getnodebyphandle(
+		    OF_getpropint(port, "phy-handle", 0));
+		if (!phynode || !OF_is_enabled(phynode) || OF_parent(phynode) != bus)
+			return EINVAL;
+		phy = OF_getpropint(phynode, "reg", -1);
+		if (phy != p + 8)
+			return EINVAL;
+		sc->sc_phy[p] = phy;
+		sc->sc_ports |= 1U << p;
+	}
+	return sc->sc_gdmnode && sc->sc_ports ? 0 : ENODEV;
+}
+
+int
+airsw_wait(struct airsw_softc *sc, unsigned int reg, uint32_t mask)
+{
+	uint32_t value;
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		value = HREAD4(sc, reg);
+		if (value == 0xdeadbeef || value == 0xffffffff)
+			return EIO;
+		if (!(value & mask))
+			return 0;
+		delay(10);
+	}
+	return ETIMEDOUT;
+}
+
+/* Keep disabled ports out of every forwarding path, even on partial failure. */
+void
+airsw_block(struct airsw_softc *sc)
+{
+	int p;
+
+	HWRITE4(sc, AIRSW_PHY_POLL, 0);
+	HWRITE4(sc, AIRSW_INT_EN, 0);
+	HWRITE4(sc, AIRSW_MFC, 0);
+	for (p = 0; p < AIRSW_NPORTS; p++) {
+		HWRITE4(sc, AIRSW_PMCR(p), AIRSW_MAC_BASE);
+		sc->sc_pmcr[p] = AIRSW_MAC_BASE;
+		HWRITE4(sc, AIRSW_PCR(p), 0);
+		HWRITE4(sc, AIRSW_SSP(p), 0);
+		HWRITE4(sc, AIRSW_PSC(p), 1U << 4); /* disable learning */
+	}
+}
+
+int
+airsw_init(struct airsw_softc *sc)
+{
+	uint32_t members, value;
+	int p, error;
+
+	airsw_block(sc);
+	HWRITE4(sc, AIRSW_SYS_CTRL, AIRSW_SYS_CTRL_PHY_RST);
+	delay(1000);
+	HWRITE4(sc, AIRSW_ATC, AIRSW_ATC_BUSY | AIRSW_ATC_FLUSH);
+	if ((error = airsw_wait(sc, AIRSW_ATC, AIRSW_ATC_BUSY)) != 0)
+		return error;
+	for (p = 0; p < AIRSW_NPORTS; p++) {
+		if (!(sc->sc_ports & (1U << p)))
+			continue;
+		error = airsw_phy_enable(sc, sc->sc_phy[p]);
+		if (error) {
+			printf("%s: port %d PHY initialization failed: %d\n",
+			    sc->sc_dev.dv_xname, p, error);
+			sc->sc_ports &= ~(1U << p);
+		}
+	}
+	if (!sc->sc_ports)
+		return ENODEV;
+	members = sc->sc_ports | (1U << AIRSW_CPU_PORT);
+	/* Raw Ethernet on the CPU link, matching GDM1's disabled STAG mode. */
+	HWRITE4(sc, AIRSW_CPORT_TAG, 0);
+	HWRITE4(sc, AIRSW_CFC, 1U << AIRSW_CPU_PORT);
+	HWRITE4(sc, AIRSW_MFC,
+	    (members << 24) | (members << 16) | (members << 8) | members);
+	/* Trap reserved link-local traffic to the CPU, preserving VLAN tags. */
+	HWRITE4(sc, 0x24, 0x02060006);
+	HWRITE4(sc, 0x28, 0x02060206);
+	HWRITE4(sc, 0x2c, 0x02060206);
+	/* 1536-byte frames cover Ethernet plus VLAN tags; no jumbo mode. */
+	value = HREAD4(sc, AIRSW_GMACCR);
+	if (value == 0xdeadbeef || value == 0xffffffff)
+		return EIO;
+	HWRITE4(sc, AIRSW_GMACCR, (value & ~0x3fU) | 1);
+	for (p = 0; p < AIRSW_NPORTS; p++) {
+		/* Transparent VLAN handling, no switch header or tag rewriting. */
+		HWRITE4(sc, AIRSW_PVC(p), 0x810000c0);
+		HWRITE4(sc, AIRSW_PVID(p), 1);
+		if (!(members & (1U << p)))
+			continue;
+		HWRITE4(sc, AIRSW_SSP(p), 0xf); /* FID0/1 forwarding */
+		HWRITE4(sc, AIRSW_PSC(p), 0); /* source address learning */
+		HWRITE4(sc, AIRSW_PCR(p), (members & ~(1U << p)) << 16);
+	}
+	HWRITE4(sc, AIRSW_MIB_CCR, AIRSW_MIB_CCR_FLUSH);
+	HWRITE4(sc, AIRSW_MIB_CCR, AIRSW_MIB_CCR_ACTIVATE);
+	sc->sc_pmcr[AIRSW_CPU_PORT] = AIRSW_MAC_BASE |
+	    AIRSW_PMCR_MAC_TX_EN | AIRSW_PMCR_MAC_RX_EN |
+	    AIRSW_PMCR_FORCE_RX_FC | AIRSW_PMCR_FORCE_TX_FC |
+	    AIRSW_PMCR_FORCE_SPD_1000 | AIRSW_PMCR_FORCE_DPX | AIRSW_PMCR_FORCE_LNK;
+	HWRITE4(sc, AIRSW_PMCR(AIRSW_CPU_PORT), sc->sc_pmcr[AIRSW_CPU_PORT]);
+	return 0;
+}
+
+/* Internal AN7581 PHYs need no firmware or vendor analog calibration. */
+int
+airsw_phy_enable(struct airsw_softc *sc, int phy)
+{
+	int id1, id2, first1, first2, val, i, error = 0;
+
+	if (phy < 8 || phy > 12)
+		return EINVAL;
+	mtx_enter(&sc->sc_mdio.am_lock);
+	if ((error = airsw_phy_write(sc, phy, 31, 0)) != 0)
+		goto out;
+	id1 = airsw_phy_read(sc, phy, MII_PHYIDR1);
+	id2 = airsw_phy_read(sc, phy, MII_PHYIDR2);
+	first1 = id1;
+	first2 = id2;
+	if (id1 < 0 || id2 < 0) {
+		error = EIO;
+		goto out;
+	}
+	for (i = 0; i < 100 &&
+	    (((uint32_t)id1 << 16) | (id2 & ~0xfU)) != AIRSW_PHY_ID; i++) {
+		delay(10000);
+		id1 = airsw_phy_read(sc, phy, MII_PHYIDR1);
+		id2 = airsw_phy_read(sc, phy, MII_PHYIDR2);
+		if (id1 < 0 || id2 < 0) {
+			error = EIO;
+			goto out;
+		}
+	}
+	if ((((uint32_t)id1 << 16) | (id2 & ~0xfU)) != AIRSW_PHY_ID) {
+		printf("%s: PHY address %d ID %04x:%04x (initial %04x:%04x)\n",
+		    sc->sc_dev.dv_xname, phy, id1, id2, first1, first2);
+		error = ENODEV;
+		goto out;
+	}
+	if (i != 0)
+		printf("%s: PHY address %d ID appeared after %d retries "
+		    "(%04x:%04x -> %04x:%04x)\n", sc->sc_dev.dv_xname, phy,
+		    i, first1, first2, id1, id2);
+	error = airsw_phy_write(sc, phy, MII_BMCR, BMCR_RESET);
+	mtx_leave(&sc->sc_mdio.am_lock);
+	if (error)
+		return error;
+	for (i = 0; i < 100; i++) {
+		delay(1000);
+		mtx_enter(&sc->sc_mdio.am_lock);
+		val = airsw_phy_read(sc, phy, MII_BMCR);
+		mtx_leave(&sc->sc_mdio.am_lock);
+		if (val < 0 || val == 0xffff)
+			return EIO;
+		if (!(val & BMCR_RESET))
+			break;
+	}
+	if (i == 100)
+		return ETIMEDOUT;
+	mtx_enter(&sc->sc_mdio.am_lock);
+	/* Disable EEE advertisement via the standard indirect MMD registers. */
+	if ((error = airsw_phy_write(sc, phy, 13, 7)) ||
+	    (error = airsw_phy_write(sc, phy, 14, 0x3c)) ||
+	    (error = airsw_phy_write(sc, phy, 13, 0x4007)) ||
+	    (error = airsw_phy_write(sc, phy, 14, 0)) ||
+	    (error = airsw_phy_write(sc, phy, MII_ANAR,
+	    ANAR_CSMA | ANAR_TX_FD | ANAR_TX | ANAR_10_FD | ANAR_10 |
+	    ANAR_PAUSE_SYM | ANAR_PAUSE_ASYM)) ||
+	    (error = airsw_phy_write(sc, phy, MII_100T2CR, GTCR_ADV_1000TFDX)) ||
+	    (error = airsw_phy_write(sc, phy, MII_BMCR, BMCR_AUTOEN | BMCR_STARTNEG)))
+		goto out;
+out:
+	mtx_leave(&sc->sc_mdio.am_lock);
+	return error;
+}
+
+/* Force each user MAC from fresh copper status, not Linux's link settings. */
+void
+airsw_tick(void *arg)
+{
+	struct airsw_softc *sc = arg;
+	uint32_t mcr;
+	int p, phy, status, gig, giglocal, partner, local;
+
+	for (p = 0; p < AIRSW_NPORTS; p++) {
+		if (!(sc->sc_ports & (1U << p)))
+			continue;
+		mcr = AIRSW_MAC_BASE;
+		phy = sc->sc_phy[p];
+		mtx_enter(&sc->sc_mdio.am_lock);
+		if (airsw_phy_write(sc, phy, 31, 0))
+			goto invalid;
+		status = airsw_phy_read(sc, phy, MII_BMSR);
+		if (status <= 0 || status == 0xffff)
+			goto invalid;
+		status = airsw_phy_read(sc, phy, MII_BMSR);
+		if (status <= 0 || status == 0xffff)
+			goto invalid;
+		if ((status & (BMSR_LINK | BMSR_ACOMP)) != (BMSR_LINK | BMSR_ACOMP))
+			goto next;
+		gig = airsw_phy_read(sc, phy, MII_100T2SR);
+		giglocal = airsw_phy_read(sc, phy, MII_100T2CR);
+		partner = airsw_phy_read(sc, phy, MII_ANLPAR);
+		local = airsw_phy_read(sc, phy, MII_ANAR);
+		if (gig <= 0 || gig == 0xffff || giglocal <= 0 || giglocal == 0xffff ||
+		    partner <= 0 || partner == 0xffff ||
+		    local <= 0 || local == 0xffff)
+			goto invalid;
+		if ((gig & GTSR_LP_1000TFDX) && (giglocal & GTCR_ADV_1000TFDX))
+			mcr |= AIRSW_PMCR_FORCE_SPD_1000 | AIRSW_PMCR_FORCE_DPX;
+		else if (local & partner & ANAR_TX_FD)
+			mcr |= AIRSW_PMCR_FORCE_SPD_100 | AIRSW_PMCR_FORCE_DPX;
+		else if (local & partner & ANAR_TX)
+			mcr |= AIRSW_PMCR_FORCE_SPD_100;
+		else if (local & partner & ANAR_10_FD)
+			mcr |= AIRSW_PMCR_FORCE_DPX;
+		else if (!(local & partner & ANAR_10))
+			goto invalid;
+		if ((mcr & AIRSW_PMCR_FORCE_DPX) && (local & partner & ANAR_PAUSE_SYM))
+			mcr |= AIRSW_PMCR_FORCE_RX_FC | AIRSW_PMCR_FORCE_TX_FC;
+		else if ((mcr & AIRSW_PMCR_FORCE_DPX) &&
+		    (local & partner & ANAR_PAUSE_ASYM)) {
+			if (local & ANAR_PAUSE_SYM)
+				mcr |= AIRSW_PMCR_FORCE_RX_FC;
+			else if (partner & ANAR_PAUSE_SYM)
+				mcr |= AIRSW_PMCR_FORCE_TX_FC;
+		}
+		mcr |= AIRSW_PMCR_MAC_TX_EN | AIRSW_PMCR_MAC_RX_EN | AIRSW_PMCR_FORCE_LNK;
+		goto next;
+invalid:
+		/* A failed MDIO read must not tear down an established link. */
+		mcr = sc->sc_pmcr[p];
+next:
+		mtx_leave(&sc->sc_mdio.am_lock);
+		if (mcr != sc->sc_pmcr[p]) {
+			HWRITE4(sc, AIRSW_PMCR(p), mcr);
+			sc->sc_pmcr[p] = mcr;
+		}
+	}
+	if (sc->sc_ready)
+		timeout_add_sec(&sc->sc_tick, 1);
+}
+
+int
+airsw_lan_ready(int gdmnode)
+{
+	struct airsw_softc *sc;
+	int i;
+
+	if (!gdmnode)
+		return 0;
+	for (i = 0; i < airsw_cd.cd_ndevs; i++) {
+		sc = airsw_cd.cd_devs[i];
+		if (sc && sc->sc_ready && sc->sc_gdmnode == gdmnode)
+			return 1;
+	}
+	return 0;
+}
+
+/*
+ * Link state and MIB counters of the user ports and the CPU port, for
+ * aireth_dump().
+ */
+void
+airsw_dump(void)
+{
+	struct airsw_softc *sc;
+	uint32_t st;
+	int port;
+
+	if (airsw_cd.cd_ndevs < 1 || airsw_cd.cd_devs[0] == NULL)
+		return;
+	sc = airsw_cd.cd_devs[0];
+	if (!sc->sc_mdio_node)
+		return;
+	printf("%s: LAN ready %d members 0x%x cpu-tag 0x%08x\n",
+	    sc->sc_dev.dv_xname, sc->sc_ready, sc->sc_ports,
+	    HREAD4(sc, AIRSW_CPORT_TAG));
+
+	for (port = 0; port <= AIRSW_CPU_PORT; port++) {
+		if (port == 5)
+			continue;
+		st = HREAD4(sc, AIRSW_PMSR(port));
+		printf("%s: port %d %s%s rx uc %u mc %u bc %u "
+		    "drop %u filt %u crc %u ingr %u arl %u | "
+		    "tx uc %u mc %u bc %u drop %u\n", sc->sc_dev.dv_xname, port,
+		    (st & AIRSW_PMSR_LINK) ? "up" : "down",
+		    (st & AIRSW_PMSR_LINK) ?
+		    ((st & AIRSW_PMSR_SPEED_1000) ? " 1000" :
+		    (st & AIRSW_PMSR_SPEED_100) ? " 100" : " 10") : "",
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_UNICAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_MULTICAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_BROADCAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_DROP),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_FILTERING),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_CRC_ERR),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_INGRESS_DROP),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_RX_ARL_DROP),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_TX_UNICAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_TX_MULTICAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_TX_BROADCAST),
+		    HREAD4(sc, AIRSW_MIB(port) + AIRSW_MIB_TX_DROP));
+	}
+}
+
+/* Find the controller of the PHY's actual DT bus, not the first switch. */
+struct air_mdio *
+airsw_mdio_by_node(int node)
+{
+	struct airsw_softc *sc;
+	int i;
+
+	if (node == 0)
+		return NULL;
+	for (i = 0; i < airsw_cd.cd_ndevs; i++) {
+		sc = airsw_cd.cd_devs[i];
+		if (sc != NULL && sc->sc_mdio_node == node)
+			return &sc->sc_mdio;
+	}
+	return NULL;
+}
